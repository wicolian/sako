# SAKO V1 - Environment Variables Template
# Copy this to .env and fill in your values

# ============================================
# DATABASE (REQUIRED)
# ============================================
DATABASE_URL=postgresql://sako:sako_password@postgres:5432/sako

# ============================================
# CLERK AUTHENTICATION (REQUIRED)
# ============================================
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ============================================
# STRIPE BILLING (REQUIRED)
# ============================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ============================================
# CORS CONFIGURATION (REQUIRED)
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ============================================
# APPLICATION URLS
# ============================================
FRONTEND_URL=http://localhost:5173
STUDIO_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3001/api/v1

# ============================================
# OPTIONAL - AI ESTIMATOR
# ============================================
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ============================================
# OPTIONAL - SLACK INTEGRATION
# ============================================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_OAUTH_REDIRECT_URL=

# ============================================
# OPTIONAL - SENTRY OBSERVABILITY
# ============================================
SENTRY_DSN=
VITE_SENTRY_DSN=

# ============================================
# OPTIONAL - POSTHOG ANALYTICS
# ============================================
VITE_PUBLIC_POSTHOG_KEY=phc_YourPostHogKeyHere
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# OPTIONAL - STORAGE (S3/R2)
# ============================================
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=sako-uploads
STORAGE_PUBLIC_URL=

# ============================================
# DOCKER PORTS
# ============================================
API_PORT=3001
STUDIO_PORT=3000
CLIENT_PORT=5173

# ============================================
# DEVELOPMENT
# ============================================
NODE_ENV=development

# ============================================
# COMPOSER INTEGRATION
# ============================================
# HMAC secret shared between sako-v1 and sako-composer for SSO token signing
COMPOSER_HMAC_SECRET=your_random_hmac_secret
# URL to the Composer app (for SSO redirects)
COMPOSER_URL=https://composer.trysako.com

# ============================================
# SUPPORT & CONTACT
# ============================================
SUPPORT_EMAIL=support@trysako.com
VITE_SUPPORT_EMAIL=support@trysako.com

# ============================================
