{
  "name": "sako-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "cd apps/client && npm run dev",
    "dev:studio": "cd apps/studio && npm run dev",
    "dev:api": "cd services/api && npm run dev",
    "build:client": "cd apps/client && npm run build",
    "build:studio": "cd apps/studio && npm run build",
    "build:api": "cd services/api && npm run prisma:generate && npm run build",
    "lint": "npm run lint:api && npm run lint:client && npm run lint:studio",
    "lint:api": "cd services/api && npm run lint --if-present",
    "lint:client": "cd apps/client && npm run lint --if-present",
    "lint:studio": "cd apps/studio && npm run lint --if-present",
    "typecheck": "npm run typecheck:api && npm run typecheck:client && npm run typecheck:studio",
    "typecheck:api": "cd services/api && npm run typecheck --if-present",
    "typecheck:client": "cd apps/client && npm run typecheck --if-present",
    "typecheck:studio": "cd apps/studio && npm run typecheck --if-present",
    "test": "cd services/api && npm test",
    "test:e2e": "cd apps/client && npm run test:e2e --if-present",
    "prisma:generate": "cd services/api && npm run prisma:generate",
    "prisma:migrate": "cd services/api && npm run prisma:migrate",
    "prisma:deploy": "cd services/api && npm run prisma:deploy",
    "prisma:studio": "cd services/api && npm run prisma:studio",
    "start:api": "cd services/api && npx prisma migrate deploy && npx prisma db seed && npm run start",
    "start:client": "cd apps/client && npx serve -s build",
    "start:studio": "cd apps/studio && npx serve -s build",
    "docker:up": "docker-compose up",
    "docker:up:build": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "docker:down:volumes": "docker-compose down -v",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "docker:ps": "docker-compose ps",
    "delete-test-user": "cd services/api && npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\"}' ../../scripts/delete-test-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.936.0",
    "@aws-sdk/s3-request-presigner": "^3.936.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@lottiefiles/dotlottie-react": "^0.17.10",
    "@rive-app/canvas": "^2.32.2",
    "@rive-app/react-canvas": "^4.24.0",
    "@types/nodemailer": "^7.0.4",
    "lottie-web": "^5.13.0",
    "nodemailer": "^7.0.10",
    "posthog-js": "^1.298.0",
    "posthog-node": "^5.14.0",
    "react-joyride": "^2.9.3",
    "react-pdf": "^10.2.0",
    "resend": "^6.5.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@railway/cli": "^4.15.1",
    "@types/multer": "^2.0.0"
  }
}
