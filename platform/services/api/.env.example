# ======================
# Database Configuration
# ======================
POSTGRES_DB=sako
POSTGRES_USER=sako
POSTGRES_PASSWORD=your_db_password
POSTGRES_PORT=5432

# Prisma / DB URL
DATABASE_URL=postgresql://<db_user>:<db_password>@<host>/<db_name>?sslmode=require&channel_binding=require
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCKS=1

# ================
# API Configuration
# ================
API_PORT=3001
NODE_ENV=development

# =======================
# Frontend Configuration
# =======================
STUDIO_PORT=3000
CLIENT_PORT=5173
VITE_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
STUDIO_URL=http://localhost:3000
# ====================
# OpenAI / LLM Config
# ====================
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your_anthropic_api_key
CODE_TO_DESIGN_API_KEY=your_code_to_design_api_key

# ============
# Stripe Config
# ============
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Core
STRIPE_PRODUCT_ID_CORE=your_stripe_product_id_core
STRIPE_PRICE_ID_CORE_MONTHLY=your_stripe_price_id_core_monthly
STRIPE_PRICE_ID_CORE_YEARLY=your_stripe_price_id_core_yearly

# Ops Base
STRIPE_PRODUCT_ID_OPS=your_stripe_product_id_ops
STRIPE_PRICE_ID_OPS_MONTHLY=your_stripe_price_id_ops_monthly
STRIPE_PRICE_ID_OPS_YEARLY=your_stripe_price_id_ops_yearly

# Enterprise
STRIPE_PRODUCT_ID_ENTERPRISE=your_stripe_product_id_enterprise
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=your_stripe_price_id_enterprise_monthly
STRIPE_PRICE_ID_ENTERPRISE_YEARLY=your_stripe_price_id_enterprise_yearly

# Composer Pro
STRIPE_PRODUCT_ID_COMPOSER_PRO=your_stripe_product_id_composer_pro
STRIPE_PRICE_ID_COMPOSER_PRO_MONTHLY=your_stripe_price_id_composer_pro_monthly
STRIPE_PRICE_ID_COMPOSER_PRO_YEARLY=your_stripe_price_id_composer_pro_yearly

# ====================
# Slack Integration
# ====================
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_BOT_TOKEN=your_slack_bot_token

SLACK_OAUTH_REDIRECT_URL=https://your-domain.com/api/v1/integrations/slack/oauth/callback
# SLACK_DEFAULT_CHANNEL_ID=C0XXXXXXX

# ===========
# Clerk Auth
# ===========
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_for_frontend

# ==========
# Monitoring
# ==========
SENTRY_DSN=your_sentry_dsn

POSTHOG_API_KEY=your_posthog_api_key
POSTHOG_HOST=https://us.i.posthog.com

# =========
# Email / SMTP
# =========
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="SAKO <noreply@updates.trysako.com>"
ADMIN_EMAIL=contact@trysako.com

# =======================
# R2 / S3-compatible config
# =======================
STORAGE_ENDPOINT=https://your-r2-endpoint
STORAGE_REGION=auto

STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key

STORAGE_BUCKET=sako-v1-uploads
STORAGE_PUBLIC_URL=https://your-public-r2-domain

# ==========
# Pinecone
# ==========
PINECONE_API_KEY=your_pinecone_api_key

# ===========
# Misc Config
# ===========
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ====================
# Composer Integration
# ====================
# HMAC secret shared between sako-v1 and sako-composer for SSO token signing
COMPOSER_HMAC_SECRET=your_random_hmac_secret
# URL to the Composer app (for SSO redirects)
COMPOSER_URL=https://composer.trysako.com

# =======================
# Enterprise Features
# =======================
# URL for strategy call booking (Cal.com, Calendly, etc) - shown to Enterprise plan users
STRATEGY_CALL_URL=https://cal.com/your-handle/intro-call

SUPPORT_EMAIL=support@trysako.com

# =======================
# Marketing / Lead Nurture
# =======================
# Feature flags (all default to false/disabled for safety)
MARKETING_LEADS_ENABLED=false
MARKETING_EMAILS_ENABLED=false
MARKETING_EMAILS_DRY_RUN=true
MARKETING_CRON_ENABLED=false

# Email configuration
MARKETING_EMAILS_FROM="SAKO <noreply@updates.trysako.com>"
MARKETING_EMAILS_REPLY_TO=support@trysako.com
MARKETING_COMPANY_ADDRESS="SAKO"

# Admin/security secrets (generate random strings)
MARKETING_ADMIN_SECRET=your_admin_secret
MARKETING_UNSUBSCRIBE_SECRET=your_unsubscribe_secret

# Stripe promo codes
STRIPE_MARKETING_BASE_COUPON_ID=your_stripe_coupon_id
MARKETING_PROMO_PERCENT_OFF=10
MARKETING_PROMO_FIRST_TIME_ONLY=false

# Calendar link for D10 email
MARKETING_CALENDAR_LINK=https://cal.com/your-calendar

# =======================
# Redis (for BullMQ queues)
# =======================
REDIS_URL=redis://localhost:6379