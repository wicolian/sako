# ============================================
# SAKO STUDIO - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# API ENDPOINT [REQUIRED]
VITE_API_URL="http://localhost:3001/api/v1"

# AUTHENTICATION [REQUIRED]
# Must be same Clerk instance as Client and Composer
VITE_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"

# STRIPE (Optional - for billing portal)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"

# ANALYTICS (Optional)
# VITE_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxx"
