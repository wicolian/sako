# ===========================================
# Sako Wall Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# ===========================================

# === AUTHENTICATION ===
# Shared password for wall access (choose a strong password)
WALL_PASSWORD=your-secure-password-here

# Secret for signing session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Secret for protecting the snapshot cron endpoint (generate with: openssl rand -hex 16)
CRON_SECRET=

# === DATABASES ===
# Wall database (new Neon project - read/write for cache, snapshots, sessions)
DATABASE_URL=postgresql://user:pass@host/database?sslmode=require

# Sako-v1 database (READ-ONLY - for user, task, subscription metrics)
SAKO_DB_URL=postgresql://user:pass@host/neondb?sslmode=require

# Composer database (READ-ONLY - for generation metrics)
COMPOSER_DB_URL=postgresql://user:pass@host/neondb?sslmode=require

# === STRIPE ===
# Your Stripe secret key (starts with sk_live_ or sk_test_)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# === POSTHOG ===
# PostHog for DAU, engagement, and activation tracking
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=phc_your_posthog_api_key
POSTHOG_PROJECT_ID=your_project_id

# === GA4 (OPTIONAL) ===
# Google Analytics 4 for website traffic metrics
# If not configured, will fall back to PostHog pageviews
# 
# Numeric property ID from GA4 Admin > Property Settings
# (NOT the G-XXXXXXXXXX measurement ID)
GA4_PROPERTY_ID=123456789

# Service account JSON (single line, escaped newlines in private_key)
# Create in Google Cloud Console > IAM > Service Accounts
# Grant "Viewer" role on GA4 property
GA4_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com",...}'

# === LINKEDIN (OPTIONAL) ===
# Auto-fetch latest post from your LinkedIn company page
#
# To enable:
# 1. Go to: https://www.linkedin.com/developers/apps/YOUR_APP_ID/products
# 2. Request "Marketing API" access (usually instant for basic access)
# 3. Add OAuth scopes: r_organization_social, rw_organization_admin
# 4. Generate access token via OAuth flow
# 5. Get organization ID from company page URL lookup
#
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
# LINKEDIN_ACCESS_TOKEN=  # Generate after Marketing API approved
# LINKEDIN_ORGANIZATION_ID=  # Numeric ID for your company page

# === OPTIONAL ===
NODE_ENV=production
