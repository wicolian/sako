{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "# SAKO Composer Dashboard\n**Production Monitoring** | [ECS Console](https://console.aws.amazon.com/ecs) | [CloudWatch Logs](https://console.aws.amazon.com/cloudwatch/home#logsV2:log-groups)"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 1,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "ECS CPU Utilization",
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          ["AWS/ECS", "CPUUtilization", "ServiceName", "sako-composer-service", "ClusterName", "sako-cluster"]
        ],
        "region": "ap-south-1",
        "period": 60,
        "stat": "Average",
        "annotations": {
          "horizontal": [
            {
              "color": "#ff7f0e",
              "label": "Scale Out Threshold",
              "value": 70
            },
            {
              "color": "#d62728",
              "label": "Critical",
              "value": 85
            }
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 6,
      "y": 1,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "ECS Memory Utilization",
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          ["AWS/ECS", "MemoryUtilization", "ServiceName", "sako-composer-service", "ClusterName", "sako-cluster"]
        ],
        "region": "ap-south-1",
        "period": 60,
        "stat": "Average",
        "annotations": {
          "horizontal": [
            {
              "color": "#ff7f0e",
              "label": "Warning",
              "value": 80
            },
            {
              "color": "#d62728",
              "label": "Critical",
              "value": 90
            }
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 1,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "ECS Running Tasks",
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          ["ECS/ContainerInsights", "RunningTaskCount", "ServiceName", "sako-composer-service", "ClusterName", "sako-cluster"],
          ["ECS/ContainerInsights", "DesiredTaskCount", "ServiceName", "sako-composer-service", "ClusterName", "sako-cluster"]
        ],
        "region": "ap-south-1",
        "period": 60,
        "stat": "Average"
      }
    },
    {
      "type": "metric",
      "x": 18,
      "y": 1,
      "width": 6,
      "height": 6,
      "properties": {
        "title": "Task Deployments",
        "view": "singleValue",
        "metrics": [
          ["ECS/ContainerInsights", "DeploymentCount", "ServiceName", "sako-composer-service", "ClusterName", "sako-cluster"]
        ],
        "region": "ap-south-1",
        "period": 300,
        "stat": "Maximum"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 7,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## Application Load Balancer"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 8,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "ALB Request Count",
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          ["AWS/ApplicationELB", "RequestCount", "LoadBalancer", "app/sako-composer-alb/REPLACE_WITH_ALB_ID"]
        ],
        "region": "ap-south-1",
        "period": 60,
        "stat": "Sum"
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 8,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "ALB Response Time (ms)",
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          ["AWS/ApplicationELB", "TargetResponseTime", "LoadBalancer", "app/sako-composer-alb/REPLACE_WITH_ALB_ID", { "stat": "p50", "label": "p50" }],
          ["...", { "stat": "p95", "label": "p95" }],
          ["...", { "stat": "p99", "label": "p99" }]
        ],
        "region": "ap-south-1",
        "period": 60
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 8,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "HTTP Error Rates",
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          ["AWS/ApplicationELB", "HTTPCode_Target_4XX_Count", "LoadBalancer", "app/sako-composer-alb/REPLACE_WITH_ALB_ID", { "label": "4xx Errors" }],
          ["AWS/ApplicationELB", "HTTPCode_Target_5XX_Count", "LoadBalancer", "app/sako-composer-alb/REPLACE_WITH_ALB_ID", { "label": "5xx Errors", "color": "#d62728" }]
        ],
        "region": "ap-south-1",
        "period": 60,
        "stat": "Sum"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 14,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## Remotion Lambda (Video Generation)"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 15,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Lambda Invocations",
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          ["AWS/Lambda", "Invocations", "FunctionName", "remotion-render-ap-south-1"]
        ],
        "region": "ap-south-1",
        "period": 300,
        "stat": "Sum"
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 15,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Lambda Duration (ms)",
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          ["AWS/Lambda", "Duration", "FunctionName", "remotion-render-ap-south-1", { "stat": "Average", "label": "Average" }],
          ["...", { "stat": "p99", "label": "p99" }]
        ],
        "region": "ap-south-1",
        "period": 300
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 15,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Lambda Errors & Throttles",
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          ["AWS/Lambda", "Errors", "FunctionName", "remotion-render-ap-south-1", { "color": "#d62728" }],
          ["AWS/Lambda", "Throttles", "FunctionName", "remotion-render-ap-south-1", { "color": "#ff7f0e" }]
        ],
        "region": "ap-south-1",
        "period": 300,
        "stat": "Sum"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 21,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## Cost & Usage"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 22,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Estimated Costs (Last 7 Days)",
        "view": "bar",
        "metrics": [
          ["AWS/Billing", "EstimatedCharges", "Currency", "USD", "ServiceName", "Amazon Elastic Container Service"],
          ["...", "ServiceName", "AWS Lambda"],
          ["...", "ServiceName", "Amazon Simple Storage Service"],
          ["...", "ServiceName", "Amazon CloudFront"]
        ],
        "region": "us-east-1",
        "period": 86400,
        "stat": "Maximum"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 22,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Total Estimated Monthly Charges",
        "view": "singleValue",
        "metrics": [
          ["AWS/Billing", "EstimatedCharges", "Currency", "USD"]
        ],
        "region": "us-east-1",
        "period": 86400,
        "stat": "Maximum"
      }
    }
  ]
}
