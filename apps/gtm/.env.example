# =============================================================================
# SAKO COMPOSER - ENVIRONMENT VARIABLES (Jan 2026)
# =============================================================================
# Copy this file to .env.local and fill in your values
#
# LEGEND:
#   [REQUIRED] - Must be set for the app to start
#   [PRODUCTION] - Required for production deployment
#   [FEATURE] - Required to enable a specific feature (graceful degradation)
#
# MINIMUM SETUP (dev):
#   - NEXT_PUBLIC_SUPABASE_URL
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - SUPABASE_SERVICE_ROLE_KEY
#   - OPENROUTER_API_KEY
#   - ENCRYPTION_SECRET
#
# Run `curl http://localhost:3000/api/setup/status` to verify configuration
# =============================================================================

# =============================================================================
# APP CONFIG
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# SUPABASE (Backend & Auth)
# Get from: https://supabase.com/dashboard/project/_/settings/api
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=               # Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon/public key
SUPABASE_SERVICE_ROLE_KEY=              # service_role key (keep secret!)

# For migrations (bun run db:migrate): Project Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# =============================================================================
# ENCRYPTION (OAuth Token Storage)
# Generate: openssl rand -hex 32
# =============================================================================
ENCRYPTION_SECRET=                       # 32+ character random string

# =============================================================================
# AI GENERATION - OpenRouter (Unified AI Routing)
# Required for: All AI features (chat, generation, embeddings)
# Get from: https://openrouter.ai/keys
# =============================================================================
OPENROUTER_API_KEY=                      # OpenRouter API key (sk-or-v1-...)

# Optional: OpenRouter settings
OPENROUTER_SITE_URL=                     # Your site URL (for rankings on openrouter.ai)
OPENROUTER_SITE_NAME=Sako Composer       # Your site name
OPENROUTER_SYSTEM_PROMPT=                # Global system prompt prepended to all AI calls

# Direct OpenAI key (only needed for LangGraph/LangChain pipelines)
OPENAI_API_KEY=                          # https://platform.openai.com/api-keys (optional)

# =============================================================================
# EVIDENCE RESEARCH + COMPETITOR INTELLIGENCE (Tavily Search)
# Required for: Evidence auto-research, claim validation, competitor analysis
# This replaces G2/Capterra/LinkedIn APIs with public web search
# Get from: https://tavily.com
# =============================================================================
TAVILY_API_KEY=

# =============================================================================
# DOMAIN IMPORT ENRICHMENT (Brandfetch)
# Optional but recommended for: fast brand import from a website URL
# Used as the primary source for company name, logos, colors, fonts, and links
# Get from: https://docs.brandfetch.com/reference/brand-api-domain
# =============================================================================
BRANDFETCH_SECRET_API_KEY=

# =============================================================================
# IMAGE GENERATION (Replicate)
# Required for: AI image generation for campaigns
# Get from: https://replicate.com/account/api-tokens
# =============================================================================
REPLICATE_API_TOKEN=

# =============================================================================
# VIDEO GENERATION
# Required for: AI voiceovers and video assembly
# =============================================================================
# ElevenLabs (Voice) - https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Video Rendering (Choose ONE of these):
# Creatomate - https://creatomate.com/dashboard/api
CREATOMATE_API_KEY=
# Shotstack - https://dashboard.shotstack.io/api
SHOTSTACK_API_KEY=
# Remotion Lambda (self-hosted)
REMOTION_LAMBDA_FUNCTION_NAME=

# =============================================================================
# RATE LIMITING (Upstash Redis)
# Required for: Production API rate limiting
# Get from: https://console.upstash.com/
# =============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# COMPETITOR INTELLIGENCE (DEPRECATED - Now uses Tavily)
# G2 API is no longer required. Competitor data is now fetched via Tavily
# search from public sources (G2, Capterra, LinkedIn pages).
# If you have a G2 API key, keep it for potential future enhanced features.
# =============================================================================
# G2_API_KEY=

# =============================================================================
# HUBSPOT INTEGRATION
# Required for: HubSpot page/form/email deployment
# Get from: https://developers.hubspot.com/
# =============================================================================
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/hubspot/oauth/callback

# =============================================================================
# EMAIL NOTIFICATIONS (Resend)
# Required for: Budget alerts, comment mentions, approval reminders
# Get from: https://resend.com/api-keys
# =============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL="Sako <noreply@sako.ai>"

# =============================================================================
# WEBFLOW INTEGRATION
# Required for: Webflow page deployment
# Get from: https://webflow.com/dashboard/integrations
# =============================================================================
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=http://localhost:3000/api/webflow/oauth/callback

# =============================================================================
# FIGMA INTEGRATION
# Required for: Figma bi-directional sync (import/export text layers)
# Get from: https://www.figma.com/developers/apps
# =============================================================================
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:3000/api/figma/oauth/callback

# Code-to-Design API (for HTML → Figma clipboard export)
# This powers the "Export to Figma" feature that creates pasteable Figma layers
# Get from: https://code.to.design (see https://docs-code.to.design/api/~endpoints)
CODE_TO_DESIGN_API_KEY=

# =============================================================================
# FRAMER INTEGRATION
# Required for: Framer project deployment
# Get from: https://www.framer.com/developers/
# Note: Framer clipboard export works WITHOUT OAuth (uses HTML format)
# =============================================================================
FRAMER_CLIENT_ID=
FRAMER_CLIENT_SECRET=
FRAMER_REDIRECT_URI=http://localhost:3000/api/framer/oauth/callback

# =============================================================================
# LINKEDIN ADS INTEGRATION
# Required for: LinkedIn ad deployment
# Get from: https://www.linkedin.com/developers/apps
# =============================================================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/providers/linkedin/callback

# =============================================================================
# TWITTER / X INTEGRATION
# Required for: Direct social publishing
# Get from: https://developer.x.com/
# =============================================================================
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/twitter/callback

# =============================================================================
# META ADS INTEGRATION
# Required for: Facebook/Instagram ad deployment
# Get from: https://developers.facebook.com/
# =============================================================================
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/providers/meta/callback

# =============================================================================
# GOOGLE ADS INTEGRATION
# Required for: Google Ads deployment
# Get from: https://console.cloud.google.com/
# =============================================================================
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=http://localhost:3000/api/providers/google-ads/callback
GOOGLE_ADS_DEVELOPER_TOKEN=              # From Google Ads API Center

# =============================================================================
# GOOGLE ANALYTICS INTEGRATION
# Required for: Analytics connection
# Get from: https://console.cloud.google.com/
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/providers/analytics/callback

# =============================================================================
# SLACK INTEGRATION
# Required for: Slack notifications and alerts
# Get from: https://api.slack.com/apps
# =============================================================================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/providers/slack/callback

# =============================================================================
# SALESFORCE INTEGRATION
# Required for: Salesforce CRM sync
# Get from: https://developer.salesforce.com/
# =============================================================================
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:3000/api/providers/salesforce/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# =============================================================================
# MAILCHIMP INTEGRATION
# Required for: Email campaign deployment
# Get from: https://admin.mailchimp.com/account/api/
# =============================================================================
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
MAILCHIMP_REDIRECT_URI=http://localhost:3000/api/providers/mailchimp/callback

# =============================================================================
# SAKO AGENCY API (Human Escalation)
# Required for: Escalate to human copywriter/designer
# Get from: https://app.trysako.com/settings/api
# =============================================================================
SAKO_V1_API_URL=https://api.trysako.com
SAKO_V1_API_KEY=
SAKO_WEBHOOK_SECRET=

# =============================================================================
# STRIPE (Billing & Subscriptions)
# Required for: Paid plans, usage metering
# Get from: https://dashboard.stripe.com/apikeys
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs (from your Stripe product catalog)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_ENTERPRISE=

# =============================================================================
# OBSERVABILITY – LangSmith (Recommended)
# For: AI call tracing, cost tracking, and evaluation in LangSmith dashboard
# Get from: https://smith.langchain.com/ → Create project (e.g. "sako") → API Keys
# =============================================================================
# Enable tracing (set to true when LANGSMITH_API_KEY is set)
LANGSMITH_TRACING=true
# LangSmith API (default below; override if using self-hosted)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
# Project name in LangSmith (e.g. "sako" or "sako-composer")
LANGSMITH_PROJECT=sako
