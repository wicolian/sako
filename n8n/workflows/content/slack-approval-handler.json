        "columns": { "mappingMode": "defineBelow", "value": { "id": "={{ $json.short_id }}", "destination_url": "={{ $json.destination_url }}", "utm_source": "={{ $json.utm_source }}", "utm_medium": "={{ $json.utm_medium }}", "utm_campaign": "={{ $json.utm_campaign }}", "utm_content": "={{ $json.utm_content }}", "created_at": "={{ $now.toISO() }}", "clicks": "0" } },
