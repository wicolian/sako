      "parameters": {
        "jsCode": "const data = $('Process Shortlink').item.json;\nlet finalText = data.final_text;\nconst shortUrl = data.short_url;\nif (finalText.includes('[LINK]')) finalText = finalText.replace('[LINK]', shortUrl);\nelse if (finalText.includes('{{link}}')) finalText = finalText.replace('{{link}}', shortUrl);\nelse { const m = finalText.match(/(\\n\\n?#[^\\n]+)$/); finalText = m ? finalText.replace(m[0], `\\n\\n${shortUrl}${m[0]}`) : `${finalText}\\n\\n${shortUrl}`; }\nreturn { json: { content_id: data.content_id, format: data.format, final_text_with_link: finalText, short_url: shortUrl, utm_campaign: data.utm_campaign } };"
