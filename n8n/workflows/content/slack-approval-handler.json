    {
      "parameters": {
        "jsCode": "// Parse Slack interactive message (crypto disallowed in n8n 2.6+, rely on URL obscurity + payload validation)\nconst input = $input.first().json;\nconst body = input.body;\n\n// Check timestamp freshness (replay protection)\nconst timestamp = input.headers['x-slack-request-timestamp'];\nif (timestamp) {\n  const currentTime = Math.floor(Date.now() / 1000);\n  if (Math.abs(currentTime - parseInt(timestamp)) > 300) {\n    throw new Error('Slack request too old');\n  }\n}\n\n// Parse the payload (Slack sends URL-encoded payload for interactive messages)\nconst payload = body.payload ? JSON.parse(body.payload) : body;\n\n// Validate this looks like a Slack interactive payload\nif (!payload.type || !payload.user) {\n  throw new Error('Invalid Slack interactive payload');\n}\n\nreturn {\n  json: {\n    type: payload.type,\n    action: payload.actions?.[0],\n    user: payload.user,\n    channel: payload.channel,\n    messageTs: payload.message?.ts,\n    responseUrl: payload.response_url\n  }\n};"
      },
      "id": "verify-slack",
      "name": "Verify Slack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the action across multiple approval types\nconst action = $input.first().json.action;\nconst actionId = action?.action_id || '';\nconst value = action?.value || '';\n\nlet actionGroup = 'content';\nif (actionId.startsWith('inmail_')) actionGroup = 'inmail';\nif (actionId.startsWith('pr_')) actionGroup = 'pr';\nif (actionId.startsWith('call_')) actionGroup = 'call';\n\nlet actionType = 'unknown';\nlet variantNumber = null;\nlet contentId = null;\nlet email = null;\n\nconst contentApproveMatch = actionId.match(/approve_v(\\d+)/);\nif (contentApproveMatch) {\n  actionGroup = 'content';\n  actionType = 'approve';\n  variantNumber = contentApproveMatch[1];\n}\n\nif (actionId === 'content_reject' || actionId === 'reject') {\n  actionGroup = 'content';\n  actionType = 'reject';\n}\n\nif (actionId === 'content_edit' || actionId === 'edit') {\n  actionGroup = 'content';\n  actionType = 'edit';\n}\n\nif (actionId === 'inmail_approve') actionType = 'approve';\nif (actionId === 'inmail_edit') actionType = 'edit';\nif (actionId === 'inmail_skip') actionType = 'skip';\nif (actionId === 'inmail_reject') actionType = 'reject';\n\nif (actionGroup === 'content') {\n  const [id, variant] = value.split('|');\n  contentId = id;\n  if (!variantNumber && variant) variantNumber = variant;\n}\n\nif (actionGroup === 'inmail') {\n  email = value;\n}\n\nreturn {\n  json: {\n    actionGroup,\n    actionType,\n    contentId,\n    variantNumber,\n    email,\n    user: $input.first().json.user,\n    responseUrl: $input.first().json.responseUrl\n  }\n};"
      },
      "id": "parse-action",
      "name": "Parse Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
