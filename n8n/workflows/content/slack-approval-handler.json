    {
      "parameters": {
        "jsCode": "// Extract the approved variant from draft_text\nconst content = $input.first().json;\nconst draftText = content.draft_text || '';\nconst variantNumber = $('Parse Action').item.json.variantNumber;\n\n// Parse variants (they're labeled VARIANT 1:, VARIANT 2:, VARIANT 3:)\nconst variantRegex = /\\*\\*VARIANT (\\d):\\*\\*([\\s\\S]*?)(?=\\*\\*VARIANT \\d:|$)/gi;\nconst matches = [...draftText.matchAll(variantRegex)];\n\nlet selectedVariant = '';\nfor (const match of matches) {\n  if (match[1] === variantNumber) {\n    selectedVariant = match[2].trim();\n    break;\n  }\n}\n\n// If no match found, use the whole draft\nif (!selectedVariant) {\n  selectedVariant = draftText;\n}\n\nreturn {\n  json: {\n    id: content.id,\n    pillar: content.pillar,\n    hook: content.hook,\n    format: content.format,\n    final_text: selectedVariant,\n    variant_selected: variantNumber\n  }\n};"
      },
