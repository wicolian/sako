      "parameters": {
        "jsCode": "// Generate UTM parameters and create trackable link (inlined from UTM Link Generator)\nconst input = $input.first()?.json ?? {};\nconst contentId = input.content_id ?? input.id;\nconst format = input.format;\nconst pillar = (input.pillar ?? 'general');\nconst finalText = input.final_text;\n\nconst formatMap = { 'LI': { source: 'linkedin', medium: 'social' }, 'X': { source: 'twitter', medium: 'social' }, 'newsletter': { source: 'newsletter', medium: 'email' }, 'blog': { source: 'blog', medium: 'content' } };\nconst utmConfig = formatMap[format] || { source: 'organic', medium: 'social' };\nconst utmParams = { utm_source: utmConfig.source, utm_medium: utmConfig.medium, utm_campaign: String(pillar).toLowerCase().replace(/\\s+/g, '_'), utm_content: contentId };\nconst destinationUrl = 'https://trysako.com/pricing';\nconst utmString = Object.entries(utmParams).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&');\nconst fullUrl = `${destinationUrl}?${utmString}`;\nconst shortId = `sako_${contentId}_${Date.now().toString(36)}`;\n\nreturn { json: { content_id: contentId, destination_url: destinationUrl, full_url: fullUrl, short_id: shortId, ...utmParams, final_text: finalText, format: format } };"
      },
