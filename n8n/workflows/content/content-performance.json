      "id": "fetch-posted",
      "name": "Fetch Posted Content",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        460,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "DmISg5P6tbWAXQv6",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Filter to content posted in last 48 hours\nconst items = $input.all();\nconst now = new Date();\nconst cutoff = new Date(now - 48 * 60 * 60 * 1000);\n\nconst recentItems = items.filter(item => {\n  const publishAt = new Date(item.json.publish_at || item.json.created_at);\n  return publishAt >= cutoff;\n});\n\nif (recentItems.length === 0) {\n  return { json: { no_recent_content: true } };\n}\n\nreturn recentItems;"
      },
      "id": "filter-recent",
      "name": "Filter Last 48h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.no_recent_content }}",
              "value2": false
            }
          ]
        }
      },
      "id": "has-content",
      "name": "Has Recent Content?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Check performance thresholds\nconst content = $('Filter Last 48h').all();\n\n// Performance thresholds\nconst thresholds = {\n  'LI': { impressions: 5000, engagements: 100 },\n  'X': { impressions: 10000, retweets: 50 },\n  'newsletter': { openRate: 0.4, clickRate: 0.1 }\n};\n\nconst results = content.map(item => {\n  const c = item.json;\n  const format = c.format;\n  const threshold = thresholds[format] || {};\n  \n  // Simulated metrics\n  const metrics = {\n    impressions: Math.floor(Math.random() * 10000),\n    engagements: Math.floor(Math.random() * 200),\n    clicks: Math.floor(Math.random() * 50)\n  };\n  \n  // Check if meets threshold\n  const meetsThreshold = \n    metrics.impressions >= (threshold.impressions || 0) ||\n    metrics.engagements >= (threshold.engagements || 0);\n  \n  return {\n    json: {\n      id: c.id,\n      pillar: c.pillar,\n      hook: c.hook,\n      format: c.format,\n      metrics,\n      meetsThreshold,\n      shouldRepurpose: meetsThreshold\n    }\n  };\n});\n\nreturn results;"
      },
      "id": "analyze-performance",
      "name": "Analyze Performance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.shouldRepurpose }}",
              "value2": true
            }
          ]
        }
      },
      "id": "should-repurpose",
      "name": "Should Repurpose?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1560,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Create repurpose tasks\nconst content = $input.first().json;\n\nconst repurposeTasks = [\n  {\n    type: 'carousel',\n    description: `Carousel version of: ${content.hook}`\n  },\n  {\n    type: 'blog',\n    description: `Deep-dive blog post: ${content.hook}`\n  },\n  {\n    type: 'newsletter_section',\n    description: `Newsletter feature: ${content.hook}`\n  },\n  {\n    type: 'sales_collateral',\n    description: `Sales snippet: ${content.hook}`\n  }\n];\n\nreturn repurposeTasks.map(task => ({\n  json: {\n    original_id: content.id,\n    ...task,\n    status: 'queued',\n    created_at: new Date().toISOString()\n  }\n}));"
      },
      "id": "create-repurpose-tasks",
      "name": "Create Repurpose Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        100
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "requestMethod": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"#content-review\",\n  \"blocks\": [\n    {\n      \"type\": \"header\",\n      \"text\": {\n        \"type\": \"plain_text\",\n        \"text\": \"🔥 Top Performer Alert!\",\n        \"emoji\": true\n      }\n    },\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \"*{{ $('Analyze Performance').item.json.hook }}*\\nHit performance threshold! Repurpose tasks created.\"\n      }\n    },\n    {\n      \"type\": \"section\",\n      \"fields\": [\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Impressions:*\\n{{ $('Analyze Performance').item.json.metrics.impressions }}\"\n        },\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Engagements:*\\n{{ $('Analyze Performance').item.json.metrics.engagements }}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
