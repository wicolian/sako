    {
      "id": "669f888e-1416-4291-a854-07ffbbbfcab1",
      "name": "Clean Website Content",
      "type": "n8n-nodes-base.code",
      "position": [
        880,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = String($input.item.json.body || '').toLowerCase();\nconst title = String($input.item.json.title || '');\nconst metaDesc = String($input.item.json.meta_description || '');\n\n// Clean and truncate content\nconst cleanContent = body\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 8000);\n\nreturn {\n  json: {\n    website_title: title,\n    website_description: metaDesc,\n    website_content: cleanContent\n  }\n};"
      },
      "typeVersion": 2,
      "continueOnFail": true
    },
    {
      "id": "merge-apollo-website",
      "name": "Merge Apollo + Website",
      "type": "n8n-nodes-base.merge",
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "combine",
        "options": {},
        "combinationMode": "mergeByPosition"
      },
      "typeVersion": 2
    },
    {
      "id": "normalize-apollo-data",
      "name": "Normalize Apollo Data",
      "type": "n8n-nodes-base.code",
      "position": [
        1300,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Split In Batches').item.json;\nconst apollo = $('Apollo: Enrich by Domain').item.json.organization || {};\nconst website = $('Clean Website Content').item.json || {};\n\n// Extract Apollo enrichment data\nconst enriched = {\n  // Original lead data\n  email: lead.email,\n  first_name: lead.first_name,\n  last_name: lead.last_name,\n  title: lead.title,\n  company: lead.company,\n  \n  // Apollo company data\n  apollo_company_name: apollo.name || '',\n  apollo_industry: apollo.industry || '',\n  apollo_employee_count: apollo.estimated_num_employees || '',\n  apollo_founded_year: apollo.founded_year || '',\n  apollo_linkedin_url: apollo.linkedin_url || '',\n  apollo_twitter_url: apollo.twitter_url || '',\n  apollo_facebook_url: apollo.facebook_url || '',\n  apollo_phone: apollo.phone || '',\n  apollo_short_description: apollo.short_description || '',\n  apollo_seo_description: apollo.seo_description || '',\n  apollo_annual_revenue: apollo.annual_revenue_printed || '',\n  apollo_technologies: (apollo.technologies || []).slice(0, 10).join(', '),\n  apollo_keywords: (apollo.keywords || []).slice(0, 10).join(', '),\n  apollo_city: apollo.city || '',\n  apollo_state: apollo.state || '',\n  apollo_country: apollo.country || '',\n  \n  // Website data\n  website_title: website.website_title || '',\n  website_description: website.website_description || '',\n  website_content: website.website_content || ''\n};\n\nreturn { json: enriched };"
      },
      "typeVersion": 2
    },
    {
      "id": "f45fcc6a-9ccd-43c9-9eaf-1797768e1e62",
      "name": "AI: Analyze Company",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        1520,
        300
      ],
      "parameters": {
        "model": "gpt-5.2",
        "messages": {
          "values": [
            {
              "content": "=Analyze this company for Sako (a design subscription service for B2B SaaS):\n\n## Company Data (from Apollo)\n- Name: {{ $json.apollo_company_name || $json.company }}\n- Industry: {{ $json.apollo_industry }}\n- Employees: {{ $json.apollo_employee_count }}\n- Location: {{ $json.apollo_city }}, {{ $json.apollo_country }}\n- Technologies: {{ $json.apollo_technologies }}\n- Description: {{ $json.apollo_short_description || $json.apollo_seo_description }}\n\n## Website Content\n- Title: {{ $json.website_title }}\n- Meta Description: {{ $json.website_description }}\n- Content (truncated): {{ $json.website_content.slice(0, 3000) }}\n\n## Contact\n- Name: {{ $json.first_name }} {{ $json.last_name }}\n- Title: {{ $json.title }}\n- Company: {{ $json.company }}\n\n## Instructions\nReturn a JSON object with:\n1. value_proposition: Company's value prop in 25 words or less (format: \"[Company] helps [audience] [achieve outcome]\")\n2. industry: One of [Software, Consumer Goods, Finance, Health Care, Education, Manufacturing, Media, Retail, Other]\n3. target_audience: One of [marketing teams, sales teams, product teams, engineering teams, founders, consumers, HR teams, C-levels]\n4. market: B2B or B2C\n5. design_maturity: low/medium/high based on website quality\n6. design_subscription_fit: yes/no with brief reason\n7. pain_points: Array of 3 likely design-related pain points\n8. recommended_package: Core ($2.5k), Ops ($4.5k), or Enterprise ($8.5k+) and why\n\nReturn ONLY valid JSON, no markdown."
            }
          ]
        },
        "options": {
          "temperature": 0,
          "maxTokens": 500
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "VJQjLnLDwAkI2PxY",
          "name": "OpenAi account"
        }
      },
      "typeVersion": 1,
      "continueOnFail": true
    },
    {
      "id": "parse-ai-response",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "position": [
        1740,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const enriched = $('Normalize Apollo Data').item.json;\nconst aiText = $json.text || $json.message?.content || '{}';\n\nlet ai = {};\ntry {\n  // Try to parse JSON from AI response\n  const jsonMatch = aiText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    ai = JSON.parse(jsonMatch[0]);\n  }\n} catch (e) {\n  console.log('Failed to parse AI response:', e.message);\n}\n\nreturn {\n  json: {\n    ...enriched,\n    \n    // AI analysis results\n    value_proposition: ai.value_proposition || '',\n    industry: ai.industry || enriched.apollo_industry || '',\n    target_audience: ai.target_audience || '',\n    market: ai.market || 'B2B',\n    design_maturity: ai.design_maturity || '',\n    design_subscription_fit: ai.design_subscription_fit || '',\n    pain_points: Array.isArray(ai.pain_points) ? ai.pain_points.join('; ') : '',\n    recommended_package: ai.recommended_package || '',\n    \n    // Metadata\n    enriched: 'true',\n    enriched_at: new Date().toISOString()\n  }\n};"
      },
      "typeVersion": 2
    },
