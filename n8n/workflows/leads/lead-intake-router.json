    {
      "parameters": {
        "jsCode": "// Normalize lead data from different sources\nconst input = $input.first().json;\nconst source = input.source;\n\nlet normalized = {\n  external_event_id: '',\n  email: '',\n  name: '',\n  company: '',\n  phone: '',\n  source: source,\n  campaign: '',\n  raw_payload: input\n};\n\nif (source === 'calcom') {\n  // Cal.com payload structure\n  const attendee = input.payload?.attendees?.[0] || {};\n  normalized.external_event_id = input.payload?.uid || '';\n  normalized.email = attendee.email || '';\n  normalized.name = attendee.name || '';\n  normalized.company = input.payload?.responses?.company?.value || '';\n  normalized.phone = input.payload?.responses?.phone?.value || '';\n  normalized.booking_time = input.payload?.startTime;\n} else if (source === 'calendly') {\n  // Calendly payload structure\n  const invitee = input.payload?.invitee || {};\n  normalized.external_event_id = input.payload?.event?.uuid || '';\n  normalized.email = invitee.email || '';\n  normalized.name = invitee.name || '';\n  normalized.company = invitee.questions_and_answers?.find(q => \n    q.question.toLowerCase().includes('company')\n  )?.answer || '';\n  normalized.phone = invitee.questions_and_answers?.find(q => \n    q.question.toLowerCase().includes('phone')\n  )?.answer || '';\n  normalized.booking_time = input.payload?.event?.start_time;\n}\n\n// Clean email\nnormalized.email = normalized.email.toLowerCase().trim();\n\n// Extract domain for enrichment\nconst emailParts = normalized.email.split('@');\nnormalized.company_domain = emailParts.length > 1 ? emailParts[1] : '';\n\nreturn { json: normalized };"
      },
