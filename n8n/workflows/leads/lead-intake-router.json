      "parameters": {
        "jsCode": "// Parse Cal.com webhook (crypto disallowed in n8n 2.6+, rely on URL obscurity + payload validation)\nconst payload = $input.first().json.body;\n\n// Validate this looks like a Cal.com webhook\nif (!payload?.triggerEvent || !payload?.payload) {\n  throw new Error('Invalid Cal.com webhook payload');\n}\n\nreturn {\n  json: {\n    ...payload,\n    source: 'calcom',\n    verified: true\n  }\n};"
      },
