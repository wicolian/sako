    {
      "parameters": {
        "jsCode": "// Parse Calendly webhook (crypto disallowed in n8n 2.6+, rely on URL obscurity + payload validation)\nconst payload = $input.first().json.body;\n\n// Validate this looks like a Calendly webhook\nif (!payload?.event || !payload?.payload) {\n  throw new Error('Invalid Calendly webhook payload');\n}\n\nreturn {\n  json: {\n    ...payload,\n    source: 'calendly',\n    verified: true\n  }\n};"
      },
      "id": "verify-calendly",
