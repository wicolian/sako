    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const items = $json.apify_items || [];\nconst primary = items[0] || {};\n\nconst emails = new Set();\nconst phones = new Set();\nconst socials = new Set();\n\nif (primary.email) emails.add(primary.email);\nif (Array.isArray(primary.emails)) primary.emails.forEach(e => emails.add(e));\nif (primary.phone) phones.add(primary.phone);\nif (Array.isArray(primary.phones)) primary.phones.forEach(p => phones.add(p));\nif (primary.linkedinUrl) socials.add(primary.linkedinUrl);\nif (primary.twitterUrl) socials.add(primary.twitterUrl);\nif (Array.isArray(primary.socials)) primary.socials.forEach(s => socials.add(s));\n\nreturn {\n  json: {\n    apify: {\n      contact_emails: Array.from(emails),\n      contact_phones: Array.from(phones),\n      contact_socials: Array.from(socials),\n      source_url: primary.url || ''\n    }\n  }\n};"
      },
      "id": "normalize-apify",
      "name": "Normalize Apify Contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        300
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "options": {},
        "combinationMode": "mergeByPosition"
      },
      "id": "merge-enrichment",
      "name": "Merge Enrichment",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        2440,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Merge enrichment data and score lead\nconst lead = $('Normalize Lead Data').item.json;\nconst clearbit = $input.first().json.clearbit || {};\nconst apify = $input.first().json.apify || {};\n\n// Extract enrichment data (handle null/missing)\nconst person = clearbit?.person || {};\nconst company = clearbit?.company || {};\n\nconst enrichedLead = {\n  ...lead,\n  // Person data\n  full_name: person.name?.fullName || lead.name,\n  title: person.employment?.title || '',\n  linkedin_url: person.linkedin?.handle ? `https://linkedin.com/in/${person.linkedin.handle}` : '',\n  \n  // Company data\n  company_name: company.name || lead.company,\n  company_domain: company.domain || lead.company_domain,\n  company_size: company.metrics?.employees || '',\n  company_industry: company.category?.industry || '',\n  company_location: company.geo?.city ? `${company.geo.city}, ${company.geo.country}` : '',\n  company_funding: company.metrics?.raised || '',\n\n  // Apify contact enrichment (fallback)\n  contact_emails: apify.contact_emails?.join(', ') || '',\n  contact_phones: apify.contact_phones?.join(', ') || '',\n  contact_socials: apify.contact_socials?.join(', ') || '',\n  \n  // Enrichment status\n  enriched: !!clearbit?.person || !!clearbit?.company || (apify.contact_emails?.length || apify.contact_phones?.length),\n  enriched_at: new Date().toISOString()\n};\n\n// Score the lead\nlet score = 0;\nconst scoreReasons = [];\n\n// Company size scoring\nif (enrichedLead.company_size >= 50 && enrichedLead.company_size <= 500) {\n  score += 20;\n  scoreReasons.push('SMB target size');\n} else if (enrichedLead.company_size > 500) {\n  score += 15;\n  scoreReasons.push('Enterprise');\n}\n\n// Title scoring (decision maker)\nconst title = (enrichedLead.title || '').toLowerCase();\nif (title.includes('founder') || title.includes('ceo') || title.includes('owner')) {\n  score += 30;\n  scoreReasons.push('Founder/CEO');\n} else if (title.includes('head') || title.includes('director') || title.includes('vp')) {\n  score += 25;\n  scoreReasons.push('Director level');\n} else if (title.includes('manager') || title.includes('lead')) {\n  score += 15;\n  scoreReasons.push('Manager level');\n}\n\n// Industry scoring (design relevance)\nconst industry = (enrichedLead.company_industry || '').toLowerCase();\nif (industry.includes('software') || industry.includes('technology') || industry.includes('saas')) {\n  score += 20;\n  scoreReasons.push('SaaS/Tech');\n} else if (industry.includes('marketing') || industry.includes('agency')) {\n  score += 15;\n  scoreReasons.push('Agency/Marketing');\n}\n\n// Booking = high intent\nscore += 20;\nscoreReasons.push('Booked call');\n\n// Add enriched flag bonus\nif (enrichedLead.enriched) {\n  score += 5;\n  scoreReasons.push('Enriched');\n}\n\nenrichedLead.score = Math.min(score, 100);\nenrichedLead.score_reasons = scoreReasons.join(', ');\nenrichedLead.is_high_intent = score >= 70;\n\nreturn { json: enrichedLead };"
      },
