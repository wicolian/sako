        "googleSheetsOAuth2Api": {
          "id": "DmISg5P6tbWAXQv6",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const call = $('Parse Quo Webhook').item.json;\nconst warmOpen = $('Lookup Contact in Warm Opens').first()?.json || {};\n\n// Determine call outcome\nlet outcome = 'unknown';\nif (call.status === 'completed' && call.duration_seconds > 60) {\n  outcome = 'connected';\n} else if (call.status === 'completed' && call.duration_seconds <= 60) {\n  outcome = 'quick_hangup';\n} else if (call.has_voicemail) {\n  outcome = 'voicemail';\n} else if (call.status === 'missed' || call.status === 'no_answer') {\n  outcome = 'no_answer';\n}\n\nreturn {\n  json: {\n    // Call details\n    call_id: call.call_id,\n    phone: call.to_number,\n    duration_seconds: call.duration_seconds,\n    duration_formatted: Math.floor(call.duration_seconds / 60) + 'm ' + (call.duration_seconds % 60) + 's',\n    outcome: outcome,\n    called_at: call.started_at,\n    \n    // Contact from warm opens (if found)\n    contact_found: !!warmOpen.email,\n    email: warmOpen.email || call.contact_email || '',\n    name: warmOpen.name || call.contact_name || '',\n    company: warmOpen.company || '',\n    \n    // Flags\n    needs_followup: outcome === 'voicemail' || outcome === 'no_answer',\n    was_connected: outcome === 'connected',\n    \n    // For transcription fetch\n    has_recording: call.has_recording\n  }\n};"
      },
      "id": "determine-outcome",
      "name": "Determine Call Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        200
      ]
    },
