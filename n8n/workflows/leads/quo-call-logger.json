{
  "id": "quo-call-logger",
  "name": "Quo Call Logger",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "quo-call-completed",
        "options": {
          "rawBody": true
        }
      },
      "id": "webhook-quo",
      "name": "Quo Webhook: Call Completed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "quo-call-completed"
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json.body || $input.first().json;\n\n// Extract call data from Quo/OpenPhone webhook\nconst call = payload.data || payload;\n\nreturn {\n  json: {\n    call_id: call.id || call.callId,\n    from_number: call.from || call.fromNumber,\n    to_number: call.to || call.toNumber,\n    direction: call.direction, // 'inbound' or 'outbound'\n    status: call.status, // 'completed', 'missed', 'voicemail'\n    duration_seconds: call.duration || call.durationSeconds || 0,\n    started_at: call.startedAt || call.createdAt,\n    ended_at: call.endedAt,\n    \n    // Contact info if available\n    contact_name: call.contact?.name || '',\n    contact_email: call.contact?.email || '',\n    \n    // For fetching transcription later\n    has_recording: call.hasRecording || false,\n    has_voicemail: call.hasVoicemail || false,\n    \n    raw_payload: payload\n  }\n};"
      },
      "id": "parse-quo-webhook",
      "name": "Parse Quo Webhook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.direction }}",
              "value2": "outbound"
            }
          ]
        }
      },
      "id": "filter-outbound",
      "name": "Filter Outbound Calls",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
