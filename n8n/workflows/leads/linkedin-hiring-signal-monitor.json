{
  "id": "linkedin-hiring-signal-monitor",
  "name": "LinkedIn Hiring Signal Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Weekly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "actor_id": "vbartonicek/linkedin-jobs-scraper",
            "run_input": "={{ { searchTerms: ['product designer', 'design lead', 'senior product designer', 'growth designer', 'brand designer'], location: 'United States', publishedAt: '7d', maxItems: 50 } }}",
            "dataset_limit": 50
          }
        }
      },
      "id": "apify-linkedin-jobs",
      "name": "Apify: LinkedIn Jobs Scraper",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.first().json.apify_items || [];\n\nconst normalizeDomain = (url) => {\n  if (!url) return '';\n  try {\n    const cleaned = url.startsWith('http') ? url : `https://${url}`;\n    const host = new URL(cleaned).hostname.replace(/^www\\./, '');\n    return host || '';\n  } catch (e) {\n    return '';\n  }\n};\n\nconst dedupe = new Set();\nconst normalized = items\n  .map((i) => {\n    const jobUrl = i.url || i.jobUrl || i.job_url || i.link || '';\n    const company = i.companyName || i.company || i.company_name || i.organization || '';\n    const companyUrl = i.companyUrl || i.company_url || i.companyWebsite || i.company_website || '';\n\n    const normalizedItem = {\n      job_title: i.title || i.jobTitle || i.position || '',\n      company,\n      location: i.location || i.jobLocation || '',\n      posted_at: i.publishedAt || i.postedAt || i.listedAt || i.datePosted || '',\n      job_url: jobUrl,\n      company_url: companyUrl,\n      company_domain: normalizeDomain(companyUrl),\n      has_domain: !!normalizeDomain(companyUrl)\n    };\n\n    return normalizedItem;\n  })\n  .filter((i) => i.company && i.job_title && i.job_url)\n  .filter((i) => {\n    if (dedupe.has(i.job_url)) return false;\n    dedupe.add(i.job_url);\n    return true;\n  });\n\nreturn normalized.map((i) => ({ json: i }));"
      },
      "id": "normalize-jobs",
      "name": "Normalize Job Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.has_domain }}",
              "value2": true
            }
          ]
        }
      },
      "id": "has-domain",
      "name": "Has Company Domain?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "actor_id": "intelecta/fast-contact-info-scraper-with-emails",
            "run_input": "={{ { startUrls: [{ url: `https://${$json.company_domain}` }] } }}",
            "dataset_limit": 3
          }
        }
      },
      "id": "apify-contact",
      "name": "Apify: Contact Scraper",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const items = $json.apify_items || [];\nconst primary = items[0] || {};\n\nconst emails = new Set();\nconst names = new Set();\n\nif (primary.email) emails.add(primary.email);\nif (Array.isArray(primary.emails)) primary.emails.forEach(e => emails.add(e));\nif (primary.contactName) names.add(primary.contactName);\nif (primary.name) names.add(primary.name);\n\nconst email = Array.from(emails)[0] || '';\nconst name = Array.from(names)[0] || '';\n\nreturn {\n  json: {\n    contact_email: email,\n    contact_name: name,\n    has_contact_email: Boolean(email)\n  }\n};"
      },
      "id": "normalize-contact",
      "name": "Normalize Contact Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\n  json: {\n    contact_email: '',\n    contact_name: '',\n    has_contact_email: false\n  }\n};"
      },
      "id": "empty-contact",
      "name": "Empty Contact Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $('Normalize Job Posts').item.json;\nconst contact = $json || {};\n\nconst [firstName, ...rest] = (contact.contact_name || '').split(' ').filter(Boolean);\n\nreturn {\n  json: {\n    job_title: job.job_title,\n    company: job.company,\n    location: job.location,\n    posted_at: job.posted_at,\n    job_url: job.job_url,\n    company_url: job.company_url,\n    company_domain: job.company_domain,\n    contact_email: contact.contact_email || '',\n    contact_name: contact.contact_name || '',\n    contact_first_name: firstName || '',\n    contact_last_name: rest.join(' '),\n    has_contact_email: contact.has_contact_email || false,\n    source: 'linkedin_hiring_signal',\n    captured_at: new Date().toISOString(),\n    reasoning: `Hiring for ${job.job_title}`,\n    green_flags: 'hiring_signal',\n    icp_score: 85,\n    status: 'qualified'\n  }\n};"
      },
