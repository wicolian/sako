    {
      "parameters": {
        "jsCode": "// Parse Cal.com webhook payload\nconst input = $input.first().json;\nconst body = typeof input.body === 'string' ? JSON.parse(input.body) : (input.body || input);\n\nconst payload = body.payload || body;\nconst eventType = body.triggerEvent || payload.triggerEvent || payload.eventType || '';\n\nconst attendees = payload.attendees || payload.attendeesList || [];\nconst attendee = attendees[0] || {};\n\nconst email = attendee.email || payload.email || '';\nconst name = attendee.name || payload.name || '';\nconst startTime = payload.startTime || payload.start || payload.start_time || '';\nconst endTime = payload.endTime || payload.end || payload.end_time || '';\nconst bookingUid = payload.uid || payload.bookingUid || payload.id || '';\nconst bookingUrl = payload.bookingUrl || payload.meetingUrl || payload.videoCallUrl || $env.CALCOM_BOOKING_LINK || '';\n\nreturn {\n  json: {\n    event_type: eventType,\n    email,\n    name,\n    start_time: startTime,\n    end_time: endTime,\n    booking_uid: bookingUid,\n    booking_url: bookingUrl\n  }\n};"
      },
      "id": "parse-calcom",
      "name": "Parse Cal.com Booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
