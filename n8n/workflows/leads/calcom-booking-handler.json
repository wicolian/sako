    {
      "parameters": {
        "jsCode": "const booking = $('Parse Cal.com Booking').item.json;\nconst warmOpen = $('Lookup Warm Opens').first()?.json || {};\n\nreturn {\n  json: {\n    email: booking.email,\n    name: booking.name || warmOpen.name || '',\n    company: warmOpen.company || '',\n    title: warmOpen.title || '',\n    phone: warmOpen.phone || '',\n    booking_uid: booking.booking_uid,\n    booking_url: booking.booking_url,\n    booked_at: booking.start_time || new Date().toISOString(),\n    event_type: booking.event_type\n  }\n};"
      },
