    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const apifyItems = $items('Apify: LinkedIn Leads Generator')?.[0]?.json?.apify_items || [];\n\nconst qualified = $items('Read Qualified Leads') || [];\nconst apolloImport = $items('Read Apollo Import') || [];\n\nconst existingEmails = new Set([\n  ...qualified.map((i) => String(i.json.email || '').toLowerCase()),\n  ...apolloImport.map((i) => String(i.json['Email'] || '').toLowerCase())\n].filter(Boolean));\n\nconst existingLinkedIn = new Set([\n  ...qualified.map((i) => String(i.json.linkedin_url || '').toLowerCase()),\n  ...apolloImport.map((i) => String(i.json['Person Linkedin Url'] || '').toLowerCase())\n].filter(Boolean));\n\nconst keyword = $items('Build Search Params')?.[0]?.json?.keyword || 'LinkedIn search';\n\nconst rows = apifyItems\n  .map((p) => {\n    const fullName = p.fullName || p.name || `${p.firstName || ''} ${p.lastName || ''}`.trim();\n    const [firstName, ...rest] = String(fullName).split(' ');\n    const lastName = rest.join(' ').trim();\n\n    return {\n      first_name: firstName || '',\n      last_name: lastName || '',\n      title: p.jobTitle || p.title || p.headline || '',\n      company: p.companyName || p.company || p.currentCompany || p.organization || '',\n      email: p.email || p.emailAddress || p.workEmail || '',\n      employees: p.companySize || p.employeeCount || '',\n      industry: p.industry || '',\n      keywords: p.keywords || '',\n      linkedin_url: p.profileUrl || p.linkedinUrl || p.profile || '',\n      website: p.companyWebsite || p.website || '',\n      company_linkedin: p.companyLinkedinUrl || p.companyLinkedin || '',\n      city: p.city || '',\n      country: p.country || ''\n    };\n  })\n  .filter((r) => r.first_name && (r.email || r.linkedin_url))\n  .filter((r) => !existingEmails.has(String(r.email || '').toLowerCase()))\n  .filter((r) => !existingLinkedIn.has(String(r.linkedin_url || '').toLowerCase()))\n  .slice(0, 100);\n\nif (rows.length === 0) {\n  return [{ json: { no_targets: true, keyword } }];\n}\n\nreturn rows.map((r) => ({\n  json: {\n    ...r,\n    keyword\n  }\n}));"
      },
