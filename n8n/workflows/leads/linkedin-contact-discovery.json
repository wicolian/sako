        "jsCode": "const input = $json || {};\n\nconst title = input.title || 'Head of Marketing';\nconst industry = input.industry || 'SaaS';\nconst location = input.location || 'US';\nconst maxLeads = input.max_leads || 50;\n\nconst keyword = `${title} ${industry}`.trim();\n\nreturn {\n  json: {\n    keyword,\n    location,\n    maxLeads\n  }\n};"
