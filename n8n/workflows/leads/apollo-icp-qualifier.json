      "parameters": {
        "jsCode": "// Aggregate results\nconst items = $input.all();\n\nconst qualified = items.filter(i => i.json.status === 'qualified').length;\nconst disqualified = items.filter(i => i.json.status === 'disqualified').length;\nconst total = qualified + disqualified;\n\nconst qualifiedList = items\n  .filter(i => i.json.status === 'qualified')\n  .map(i => `• ${i.json.first_name} ${i.json.last_name} (${i.json.title} @ ${i.json.company}) - Score: ${i.json.icp_score}`);\n\nreturn {\n  json: {\n    summary: {\n      total_processed: total,\n      qualified: qualified,\n      disqualified: disqualified,\n      pass_rate: Math.round((qualified / total) * 100) + '%'\n    },\n    qualified_contacts: qualifiedList.slice(0, 20), // Top 20 for Slack\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "aggregate-results",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
