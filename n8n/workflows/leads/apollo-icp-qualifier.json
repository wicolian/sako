        "messages": {
          "values": [
            {
              "content": "=You are an ICP (Ideal Customer Profile) qualifier for Sako, a design subscription service for B2B SaaS companies.\n\nSako's ICP:\n- Role: Marketing lead, Founder, CMO, VP Marketing, Head of Growth, PMM, Brand Manager\n- Company: B2B SaaS (software companies selling to businesses)\n- Size: 20-500 employees (too small = no budget, too big = enterprise procurement)\n- Need: Ongoing design/GTM assets (landing pages, pitch decks, ad creative, motion graphics)\n- Budget: Can approve $2.5k-$8.5k+/month (call-led)\n\nDISQUALIFY if:\n- Crypto/blockchain/web3 company\n- Sales role (not decision maker for design)\n- Enterprise (>1000 employees)\n- Agency/consultancy (competitors)\n- Healthcare/finance with heavy compliance\n- Non-B2B (consumer companies)\n\nScore this contact (0-100) and explain:\n\nName: {{ $json['First Name'] }} {{ $json['Last Name'] }}\nTitle: {{ $json['Title'] }}\nCompany: {{ $json['Company Name'] }}\nIndustry: {{ $json['Industry'] }}\nEmployees: {{ $json['# Employees'] }}\nKeywords: {{ $json['Keywords'] }}\n\nRespond in JSON format:\n{\n  \"score\": <0-100>,\n  \"qualified\": <true if score >= 70>,\n  \"reasoning\": \"<1-2 sentences explaining score>\",\n  \"red_flags\": [\"<any disqualifying factors>\"],\n  \"green_flags\": [\"<positive ICP signals>\"]\n}"
            }
          ]
        }
      },
      "id": "ai-score-contact",
      "name": "AI: Score Contact",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "VJQjLnLDwAkI2PxY",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst contact = $('Batch Contacts').item.json;\n\n// Parse AI response\nlet aiResponse;\ntry {\n  // Extract JSON from the AI response\n  const responseText = input.message?.content || input.text || '';\n  const jsonMatch = responseText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    aiResponse = JSON.parse(jsonMatch[0]);\n  } else {\n    throw new Error('No JSON found in AI response');\n  }\n} catch (e) {\n  aiResponse = {\n    score: 0,\n    qualified: false,\n    reasoning: 'Failed to parse AI response',\n    red_flags: ['parse_error'],\n    green_flags: []\n  };\n}\n\nreturn {\n  json: {\n    // Original contact data\n    first_name: contact['First Name'],\n    last_name: contact['Last Name'],\n    email: contact['Email'],\n    title: contact['Title'],\n    company: contact['Company Name'],\n    industry: contact['Industry'],\n    employees: contact['# Employees'],\n    linkedin_url: contact['Person Linkedin Url'],\n    company_linkedin: contact['Company Linkedin Url'],\n    website: contact['Website'],\n    \n    // ICP scoring\n    icp_score: aiResponse.score,\n    qualified: aiResponse.qualified,\n    reasoning: aiResponse.reasoning,\n    red_flags: aiResponse.red_flags?.join(', ') || '',\n    green_flags: aiResponse.green_flags?.join(', ') || '',\n    \n    // Status tracking\n    status: aiResponse.qualified ? 'qualified' : 'disqualified',\n    scored_at: new Date().toISOString()\n  }\n};"
      },
      "id": "parse-ai-response",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
