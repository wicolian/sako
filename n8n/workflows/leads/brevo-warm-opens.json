      "name": "Daily 8am IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.brevo.com/v3/smtp/statistics/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "event",
              "value": "opened"
            },
            {
              "name": "startDate",
              "value": "={{ $now.minus({days: 7}).toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "endDate",
              "value": "={{ $now.toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "limit",
              "value": "500"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "get-brevo-opens",
      "name": "Brevo: Get Email Opens",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        460,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "bAJ8LsgwGI2XHllf",
          "name": "Brevo account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const events = $input.first().json.events || [];\n\n// Group opens by email\nconst opensByEmail = {};\n\nevents.forEach(event => {\n  const email = event.email;\n  if (!opensByEmail[email]) {\n    opensByEmail[email] = {\n      email: email,\n      open_count: 0,\n      opens: [],\n      campaigns: new Set()\n    };\n  }\n  opensByEmail[email].open_count++;\n  opensByEmail[email].opens.push({\n    date: event.date,\n    campaign: event.tag || event.subject || 'Unknown'\n  });\n  if (event.tag) opensByEmail[email].campaigns.add(event.tag);\n});\n\n// Filter for warm opens: 2+ opens OR opened in last 48h\nconst now = new Date();\nconst fortyEightHoursAgo = new Date(now.getTime() - 48 * 60 * 60 * 1000);\n\nconst warmOpens = Object.values(opensByEmail).filter(contact => {\n  const recentOpen = contact.opens.some(o => new Date(o.date) > fortyEightHoursAgo);\n  return contact.open_count >= 2 || recentOpen;\n});\n\n// Sort by open count descending\nwarmOpens.sort((a, b) => b.open_count - a.open_count);\n\n// Return as array of items\nreturn warmOpens.map(contact => ({\n  json: {\n    email: contact.email,\n    open_count: contact.open_count,\n    last_open: contact.opens[0]?.date || '',\n    campaigns: Array.from(contact.campaigns).join(', '),\n    is_hot: contact.open_count >= 3\n  }\n}));"
      },
      "id": "filter-warm-opens",
      "name": "Filter Warm Opens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "1kuvMIZS5a7GYnHDlByL4LfkQf1kHbVxSmL8LogIjMgQ",
          "cachedResultName": "Sako Marketing Automations",
          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/1kuvMIZS5a7GYnHDlByL4LfkQf1kHbVxSmL8LogIjMgQ/edit?usp=drivesdk"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": 1096236767,
          "cachedResultName": "warm_opens",
          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/1kuvMIZS5a7GYnHDlByL4LfkQf1kHbVxSmL8LogIjMgQ/edit#gid=1096236767"
        },
        "options": {}
      },
      "id": "get-already-called",
      "name": "Get Already Called",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        900,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "DmISg5P6tbWAXQv6",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const warmOpens = $('Filter Warm Opens').all();\nconst alreadyCalled = $('Get Already Called').all();\n\n// Get list of already called emails\nconst calledEmails = new Set(\n  alreadyCalled\n    .filter(i => i.json.call_status === 'called' || i.json.call_status === 'meeting_booked')\n    .map(i => i.json.email?.toLowerCase())\n);\n\n// Filter out already called\nconst newWarmOpens = warmOpens.filter(contact => \n  !calledEmails.has(contact.json.email?.toLowerCase())\n);\n\nreturn newWarmOpens;"
      },
      "id": "filter-not-called",
      "name": "Filter Not Yet Called",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apollo.io/v1/people/match",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{ $json.email }}\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "enrich-apollo",
      "name": "Apollo: Enrich Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1340,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "XsUtKQ6O9aPU0HyZ",
          "name": "Apollo"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const warmOpen = $('Filter Not Yet Called').item.json;\nconst apollo = $input.first().json.person || {};\n\nreturn {\n  json: {\n    // Contact info\n    email: warmOpen.email,\n    name: apollo.name || warmOpen.email.split('@')[0],\n    first_name: apollo.first_name || '',\n    last_name: apollo.last_name || '',\n    title: apollo.title || '',\n    company: apollo.organization?.name || '',\n    linkedin_url: apollo.linkedin_url || '',\n    phone: apollo.phone_numbers?.[0]?.raw_number || '',\n    \n    // Open stats\n    open_count: warmOpen.open_count,\n    last_open: warmOpen.last_open,\n    campaigns: warmOpen.campaigns,\n    is_hot: warmOpen.is_hot,\n    \n    // Status\n    call_status: 'pending',\n    flagged_at: new Date().toISOString()\n  }\n};"
      },
