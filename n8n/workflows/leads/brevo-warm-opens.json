    {
      "parameters": {
        "model": "gpt-5.2",
        "options": {
          "temperature": 0.7,
          "maxTokens": 200
        },
        "messages": {
          "values": [
            {
              "content": "=Generate a brief, friendly call opener for a cold call to a warm lead.\n\nContext:\n- Name: {{ $json.name }}\n- Title: {{ $json.title }}\n- Company: {{ $json.company }}\n- They opened our email {{ $json.open_count }} times\n- Campaign: {{ $json.campaigns }}\n- We sell design subscriptions for B2B SaaS companies\n\nGenerate a 2-3 sentence opener that:\n1. Acknowledges they've been looking at our emails\n2. Asks a qualifying question about their design needs\n3. Is conversational, not salesy\n\nJust the opener text, nothing else."
            }
          ]
        }
      },
      "id": "generate-opener",
      "name": "AI: Generate Call Opener",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        1780,
        400
      ],
      "credentials": {
        "openAiApi": {
          "id": "VJQjLnLDwAkI2PxY",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "channel": "#sako-leads",
        "text": "={{ $json.is_hot ? '🔥🔥🔥' : '🔥' }} *WARM OPEN: Call within 48h*\n\n*Contact:*\n• Name: {{ $('Merge Open + Apollo Data').item.json.name }}\n• Title: {{ $('Merge Open + Apollo Data').item.json.title || 'Unknown' }}\n• Company: {{ $('Merge Open + Apollo Data').item.json.company || 'Unknown' }}\n• Email: {{ $('Merge Open + Apollo Data').item.json.email }}\n• Phone: {{ $('Merge Open + Apollo Data').item.json.phone || 'Not available' }}\n{{ $('Merge Open + Apollo Data').item.json.linkedin_url ? '• LinkedIn: ' + $('Merge Open + Apollo Data').item.json.linkedin_url : '' }}\n\n*Engagement:*\n• Opens: {{ $('Merge Open + Apollo Data').item.json.open_count }} (last: {{ $('Merge Open + Apollo Data').item.json.last_open }})\n• Campaign: {{ $('Merge Open + Apollo Data').item.json.campaigns }}\n\n*Suggested Opener:*\n_{{ $json.message?.content || $json.text || 'Hey [Name], noticed you\\'ve been checking out our emails. Quick question - are you handling design in-house or working with external partners?' }}_",
        "attachments": [
          {
            "fallback": "Call actions",
            "actions": [
              {
                "type": "button",
                "text": "📋 Generate Full Brief",
                "url": "={{ $env.WEBHOOK_URL }}/webhook/call-prep-trigger?email={{ $('Merge Open + Apollo Data').item.json.email }}"
              },
              {
                "type": "button",
                "text": "📅 Send Cal Link",
                "url": "={{ $env.CALCOM_BOOKING_LINK }}?email={{ $('Merge Open + Apollo Data').item.json.email }}&name={{ $('Merge Open + Apollo Data').item.json.name }}"
              },
              {
                "type": "button",
                "text": "✅ Mark as Called",
                "url": "={{ $env.WEBHOOK_URL }}/webhook/mark-called?email={{ $('Merge Open + Apollo Data').item.json.email }}&status=called"
              },
              {
                "type": "button",
                "text": "📅 Meeting Booked",
                "url": "={{ $env.WEBHOOK_URL }}/webhook/mark-called?email={{ $('Merge Open + Apollo Data').item.json.email }}&status=meeting_booked"
              },
              {
                "type": "button",
                "text": "⏭️ Skip",
                "url": "={{ $env.WEBHOOK_URL }}/webhook/mark-called?email={{ $('Merge Open + Apollo Data').item.json.email }}&status=skipped"
              }
            ]
          }
        ],
        "otherOptions": {}
      },
