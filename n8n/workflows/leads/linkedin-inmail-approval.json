        "requestMethod": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"#sako-leads\",\n  \"blocks\": [\n    {\n      \"type\": \"header\",\n      \"text\": {\n        \"type\": \"plain_text\",\n        \"text\": \"📩 InMail Ready for Review\",\n        \"emoji\": true\n      }\n    },\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \"*To:* {{ $json.first_name }} {{ $json.last_name }} ({{ $json.title }} @ {{ $json.company }})\\n*Subject:* {{ $json.subject }}\\n\\n*Draft:*\\n{{ $json.body }}\\n\\n*Personalization:* {{ $json.personalization_hook }}\\n*Recommended Package:* {{ $json.recommended_package }}\"\n      }\n    },\n    {\n      \"type\": \"actions\",\n      \"elements\": [\n        {\n          \"type\": \"button\",\n          \"text\": {\n            \"type\": \"plain_text\",\n            \"text\": \"✅ Approve\",\n            \"emoji\": true\n          },\n          \"action_id\": \"inmail_approve\",\n          \"value\": \"{{ $json.email }}\"\n        },\n        {\n          \"type\": \"button\",\n          \"text\": {\n            \"type\": \"plain_text\",\n            \"text\": \"✏️ Edit\",\n            \"emoji\": true\n          },\n          \"action_id\": \"inmail_edit\",\n          \"value\": \"{{ $json.email }}\"\n        },\n        {\n          \"type\": \"button\",\n          \"text\": {\n            \"type\": \"plain_text\",\n            \"text\": \"⏭️ Skip\",\n            \"emoji\": true\n          },\n          \"action_id\": \"inmail_skip\",\n          \"value\": \"{{ $json.email }}\"\n        },\n        {\n          \"type\": \"button\",\n          \"text\": {\n            \"type\": \"plain_text\",\n            \"text\": \"🗑️ Reject\",\n            \"emoji\": true\n          },\n          \"action_id\": \"inmail_reject\",\n          \"value\": \"{{ $json.email }}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
