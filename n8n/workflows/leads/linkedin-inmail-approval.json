        "jsCode": "const query = $json.query || {};\n\nconst status = query.status || 'skipped';\nconst email = query.email || '';\n\nreturn {\n  json: {\n    email,\n    status,\n    approved_by: query.user || 'slack',\n    approved_at: new Date().toISOString()\n  }\n};"
