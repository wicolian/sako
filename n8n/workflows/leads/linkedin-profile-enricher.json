    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rows = $input.all();\n\nconst filtered = rows.filter((r) => {\n  const linkedin = String(r.json.linkedin_url || '').trim();\n  const companyLinkedin = String(r.json.apollo_linkedin_url || '').trim();\n  const alreadyEnriched = String(r.json.linkedin_enriched || '').toLowerCase() === 'true';\n\n  return !alreadyEnriched && (linkedin || companyLinkedin);\n});\n\nreturn filtered.length > 0 ? filtered : [{ json: { no_targets: true } }];"
      },
