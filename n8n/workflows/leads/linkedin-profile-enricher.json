    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const items = $json.apify_items || [];\nconst profile = items[0] || {};\n\nconst recent = profile.recentActivity || profile.recentPosts || [];\nconst recentPost = recent[0]?.text || recent[0]?.content || '';\n\nreturn {\n  json: {\n    profile_headline: profile.headline || '',\n    profile_company: profile.companyName || '',\n    recent_linkedin_post: recentPost,\n    profile_recent_raw: JSON.stringify(recent.slice(0, 3))\n  }\n};"
      },
      "id": "normalize-profile",
      "name": "Normalize Profile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
