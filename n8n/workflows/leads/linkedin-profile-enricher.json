        "jsCode": "const items = $json.apify_items || [];\nconst company = items[0] || {};\n\nconst updates = company.recentPosts || company.posts || company.updates || [];\nconst jobs = company.jobs || company.jobPostings || company.openJobs || [];\n\nreturn {\n  json: {\n    company_recent_news: JSON.stringify(updates.slice(0, 3)),\n    company_hiring_signals: JSON.stringify(jobs.slice(0, 5)),\n    headcount_change: company.headcountGrowth || company.employeeGrowth || company.headcountChange || ''\n  }\n};"
      },
