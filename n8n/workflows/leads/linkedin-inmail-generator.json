        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-5.2",
        "options": {
          "temperature": 0.4,
          "maxTokens": 250
        },
        "messages": {
          "values": [
            {
              "content": "=You are writing a LinkedIn InMail for Sako, a design subscription for B2B SaaS. All plans are currently call-led sales.\n\n## Sako Packages\n- Core: $2,500/mo - 1 active task, 15 tasks/mo, 2 seats\n- Ops: $4,500/mo - 2 active tasks, 30 tasks/mo, 4 seats\n- Enterprise: starts at $8,500/mo - 3+ tasks, 45+ tasks/mo, 5+ seats\nAll include: Design + Motion, 48h turnaround, unlimited requests/revisions\n\n## Prospect\n- Name: {{ $json.first_name }} {{ $json.last_name }}\n- Title: {{ $json.title }}\n- Company: {{ $json.company }}\n- Recent Post: {{ $json.recent_linkedin_post }}\n- Company News: {{ $json.company_recent_news }}\n- Pain Points: {{ $json.pain_points }}\n- Tech Stack: {{ $json.apollo_technologies }}\n\n## Rules\n1. Subject: 6-10 words, reference something specific to them\n2. Body: Under 300 characters, one pain point, soft CTA for 15-min call\n3. Tone: Founder-to-founder, direct, zero fluff\n4. Use their post/company news if available\n\nReturn ONLY valid JSON:\n{\n  \"subject\": \"...\",\n  \"body\": \"...\",\n  \"personalization_hook\": \"...\"\n}"
            }
          ]
        }
      },
      "id": "generate-inmail",
      "name": "AI: Generate InMail",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        1560,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "VJQjLnLDwAkI2PxY",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Split In Batches').item.json;\nconst responseText = $json.message?.content || $json.text || '';\n\nlet parsed = {};\ntry {\n  const match = responseText.match(/\\{[\\s\\S]*\\}/);\n  if (match) parsed = JSON.parse(match[0]);\n} catch (e) {\n  parsed = {};\n}\n\nreturn {\n  json: {\n    email: lead.email,\n    linkedin_url: lead.linkedin_url,\n    first_name: lead.first_name,\n    last_name: lead.last_name,\n    title: lead.title,\n    company: lead.company,\n    subject: parsed.subject || '',\n    body: parsed.body || '',\n    personalization_hook: parsed.personalization_hook || '',\n    recommended_package: lead.recommended_package || '',\n    status: 'draft',\n    generated_at: new Date().toISOString()\n  }\n};"
      },
      "id": "parse-response",
      "name": "Parse InMail Response",
      "type": "n8n-nodes-base.code",
