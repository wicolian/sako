    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const leads = $items('Read Qualified Leads') || [];\nconst existing = $items('Read InMail Outreach') || [];\n\nconst existingEmails = new Set(\n  existing.map((i) => String(i.json.email || '').toLowerCase()).filter(Boolean)\n);\n\nconst eligible = leads.filter((l) => {\n  const email = String(l.json.email || '').toLowerCase();\n  const status = String(l.json.status || '').toLowerCase();\n  const linkedinEnriched = String(l.json.linkedin_enriched || '').toLowerCase() === 'true';\n  return email && status === 'qualified' && linkedinEnriched && !existingEmails.has(email);\n});\n\nreturn eligible.length > 0 ? eligible : [{ json: { no_targets: true } }];"
      },
      "id": "filter-eligible",
      "name": "Filter Eligible Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.no_targets }}",
              "value2": false
            }
          ]
        }
      },
