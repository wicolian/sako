    {
      "parameters": {
        "model": "gpt-5.2",
        "options": {
          "temperature": 0.2,
          "maxTokens": 300
        },
        "messages": {
          "values": [
            {
              "content": "=Score this designer candidate for Sako (0-100).\n\n## Role Requirements\n- Motion design: After Effects, Premiere Pro, motion graphics\n- Design: Figma, UI/UX, landing pages, social design\n- Experience: 2-5 years (agency or SaaS preferred)\n- Soft skills: fast turnaround, client communication\n\n## Candidate\n- Name: {{ $json.name }}\n- Title: {{ $json.title }}\n- Company: {{ $json.current_company }}\n- Skills: {{ $json.skills }}\n- Portfolio: {{ $json.portfolio_url }}\n- Experience (years): {{ $json.experience_years }}\n\n## Output JSON\n{\n  \"score\": 0-100,\n  \"strengths\": [\"...\"],\n  \"gaps\": [\"...\"],\n  \"recommended_action\": \"shortlist|review|pass\"\n}"
            }
          ]
        }
      },
      "id": "score-candidate",
      "name": "AI: Score Candidate",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "VJQjLnLDwAkI2PxY",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const candidate = $('Split In Batches').item.json;\nconst responseText = $json.message?.content || $json.text || '';\n\nlet parsed = {};\ntry {\n  const match = responseText.match(/\\{[\\s\\S]*\\}/);\n  if (match) parsed = JSON.parse(match[0]);\n} catch (e) {\n  parsed = { score: 0, strengths: [], gaps: ['parse_error'], recommended_action: 'review' };\n}\n\nconst action = String(parsed.recommended_action || 'review').toLowerCase();\nconst status = action === 'shortlist' ? 'shortlisted' : action === 'pass' ? 'rejected' : 'screened';\n\nreturn {\n  json: {\n    linkedin_url: candidate.linkedin_url,\n    score: parsed.score || 0,\n    strengths: Array.isArray(parsed.strengths) ? parsed.strengths.join('; ') : '',\n    gaps: Array.isArray(parsed.gaps) ? parsed.gaps.join('; ') : '',\n    status\n  }\n};"
      },
      "id": "parse-score",
      "name": "Parse Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
