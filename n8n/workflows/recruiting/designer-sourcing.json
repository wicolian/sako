    {
      "parameters": {
        "mode": "passThrough"
      },
      "id": "merge-inputs",
      "name": "Merge Inputs",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $items('Apify: LinkedIn Leads Generator')?.[0]?.json?.apify_items || [];\nconst existing = $items('Read Candidate Pipeline') || [];\n\nconst existingLinkedIn = new Set(\n  existing.map((i) => String(i.json.linkedin_url || '').toLowerCase()).filter(Boolean)\n);\n\nconst keyword = $items('Build Search Params')?.[0]?.json?.keyword || 'Designer search';\n\nconst rows = items\n  .map((p) => {\n    const fullName = p.fullName || p.name || `${p.firstName || ''} ${p.lastName || ''}`.trim();\n    return {\n      linkedin_url: p.profileUrl || p.linkedinUrl || p.profile || '',\n      name: fullName,\n      title: p.jobTitle || p.title || p.headline || '',\n      current_company: p.companyName || p.company || p.currentCompany || '',\n      email: p.email || p.emailAddress || '',\n      phone: p.phone || '',\n      skills: p.skills || '',\n      experience_years: p.yearsExperience || '',\n      portfolio_url: p.website || p.portfolio || ''\n    };\n  })\n  .filter((r) => r.name && r.linkedin_url)\n  .filter((r) => !existingLinkedIn.has(String(r.linkedin_url || '').toLowerCase()))\n  .slice(0, 100);\n\nif (rows.length === 0) {\n  return [{ json: { no_targets: true, keyword } }];\n}\n\nreturn rows.map((r) => ({\n  json: {\n    ...r,\n    status: 'sourced',\n    sourced_at: new Date().toISOString(),\n    keyword\n  }\n}));"
      },
      "id": "normalize-dedupe",
      "name": "Normalize + Dedupe Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
