    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $items('Normalize + Dedupe Candidates') || [];\n\nconst keyword = rows[0]?.json?.keyword || 'Designer search';\nconst total = rows.filter((r) => !r.json.no_targets).length;\n\nreturn [{\n  json: {\n    keyword,\n    total\n  }\n}];"
      },
