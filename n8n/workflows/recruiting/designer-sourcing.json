          "mode": "list",
          "value": ""
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "actor_id": "caprolok/linkedin-leads-generator",
            "run_input": "={{ { keyword: $json.keyword, location: $json.location, max_leads: $json.maxLeads } }}",
            "dataset_limit": 200
          }
        }
      },
      "id": "apify-linkedin-leads",
