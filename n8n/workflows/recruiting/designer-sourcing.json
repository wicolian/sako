    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json || {};\n\nconst title = input.title || 'Motion Designer';\nconst skills = input.skills || 'After Effects Figma';\nconst location = input.location || 'India';\nconst maxLeads = input.max_leads || 30;\n\nconst keyword = `${title} ${skills}`.trim();\n\nreturn {\n  json: {\n    keyword,\n    location,\n    maxLeads\n  }\n};"
      },
      "id": "build-search",
      "name": "Build Search Params",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
