      "parameters": {
        "model": "gpt-5.2",
        "options": {
          "temperature": 0.4,
          "maxTokens": 250
        },
        "messages": {
          "values": [
            {
              "content": "=Write a recruiting LinkedIn InMail for Sako.\n\n## Role\n- Creative & Motion Designer (remote, India)\n- Fast-paced, 48h turnarounds\n- Variety: SaaS landing pages, pitch decks, social, motion graphics\n\n## Candidate\n- Name: {{ $json.name }}\n- Title: {{ $json.title }}\n- Company: {{ $json.current_company }}\n- Skills: {{ $json.skills }}\n\n## Tone\n- Casual, startup energy\n- Highlight creative variety and growth\n- Soft CTA: 15-min chat about the role\n\nReturn ONLY valid JSON:\n{\n  \"subject\": \"...\",\n  \"body\": \"...\"\n}"
            }
          ]
        }
      },
      "id": "generate-message",
      "name": "AI: Generate Recruiting InMail",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "VJQjLnLDwAkI2PxY",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const candidate = $('Split In Batches').item.json;\nconst responseText = $json.message?.content || $json.text || '';\n\nlet parsed = {};\ntry {\n  const match = responseText.match(/\\{[\\s\\S]*\\}/);\n  if (match) parsed = JSON.parse(match[0]);\n} catch (e) {\n  parsed = { subject: '', body: '' };\n}\n\nconst notes = `subject: ${parsed.subject || ''}\\nbody: ${parsed.body || ''}`.trim();\n\nreturn {\n  json: {\n    linkedin_url: candidate.linkedin_url,\n    notes,\n    status: 'outreach_ready'\n  }\n};"
      },
      "id": "prepare-update",
      "name": "Prepare Outreach Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
