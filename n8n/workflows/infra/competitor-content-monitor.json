{
  "id": "competitor-content-monitor",
  "name": "Competitor Content Change Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "cron",
      "name": "Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": 100000009,
          "cachedResultName": "content_monitor_targets",
          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/1kuvMIZS5a7GYnHDlByL4LfkQf1kHbVxSmL8LogIjMgQ/edit#gid=100000009"
        },
        "filters": {
          "filter": [
            {
              "column": "enabled",
              "value": "true"
            }
          ]
        },
        "options": {},
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "1kuvMIZS5a7GYnHDlByL4LfkQf1kHbVxSmL8LogIjMgQ",
          "cachedResultName": "Sako Marketing Automations",
          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/1kuvMIZS5a7GYnHDlByL4LfkQf1kHbVxSmL8LogIjMgQ/edit?usp=drivesdk"
        }
      },
      "id": "fetch-targets",
      "name": "Fetch Monitor Targets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        460,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "DmISg5P6tbWAXQv6",
          "name": "Google Sheets account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "actor_id": "jakubbalada/content-checker",
            "run_input": "={{ {\n  url: $json.url,\n  contentSelector: $json.contentSelector || 'body',\n  screenshotSelector: $json.screenshotSelector || $json.contentSelector || 'body',\n  proxy: { useApifyProxy: true }\n} }}",
            "dataset_limit": 3
          }
        }
      },
      "id": "apify-content-checker",
      "name": "Apify: Content Checker",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const target = $('Split In Batches').item.json;\nconst items = $json.apify_items || [];\n\n// Per actor docs: dataset items are pushed only when content changes\nconst changed = Array.isArray(items) && items.length > 0;\n\nreturn {\n  json: {\n    url: target.url,\n    label: target.label || target.name || '',\n    contentSelector: target.contentSelector || 'body',\n    changed,\n    change_items: items.slice(0, 3)\n  }\n};"
      },
      "id": "detect-change",
      "name": "Detect Change",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.changed }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-changed",
      "name": "Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-5.2",
        "messages": {
          "values": [
            {
              "content": "=Summarize the competitor content change into a short alert for a founder.\n\nCompetitor: {{ $json.label || $json.url }}\nURL: {{ $json.url }}\nSelector: {{ $json.contentSelector }}\n\nChange payload (JSON):\n{{ JSON.stringify($json.change_items, null, 2) }}\n\nOutput Markdown with:\n- What likely changed (1-2 sentences)\n- Why it matters to Sako (1 sentence)\n- Suggested action (1 bullet)\n\nKeep it under 800 characters."
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 300
        }
      },
      "id": "summarize-change",
      "name": "Summarize Change (GPT-5.2)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1560,
        220
      ],
      "credentials": {
        "openAiApi": {
          "id": "VJQjLnLDwAkI2PxY",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "requestMethod": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"#signals\",\n  \"text\": \"Competitor change detected\\n\\n\" + $json.text\n}",
        "options": {}
      },
      "id": "post-slack",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1780,
        220
      ],
      "credentials": {
        "slackOAuth2Api": {
          "id": "Hypoe71bz8A0qpQ3",
          "name": "Slack account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "update",
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": 100000009,
          "cachedResultName": "content_monitor_targets",
          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/1kuvMIZS5a7GYnHDlByL4LfkQf1kHbVxSmL8LogIjMgQ/edit#gid=100000009"
        },
        "filters": {
          "filter": [
            {
              "column": "url",
              "value": "={{ $json.url }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "last_changed_at": "={{ $now.toISO() }}",
            "last_change_summary": "={{ $json.text }}"
          }
        },
        "options": {},
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "1kuvMIZS5a7GYnHDlByL4LfkQf1kHbVxSmL8LogIjMgQ",
          "cachedResultName": "Sako Marketing Automations",
          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/1kuvMIZS5a7GYnHDlByL4LfkQf1kHbVxSmL8LogIjMgQ/edit?usp=drivesdk"
        }
      },
      "id": "update-sheet",
      "name": "Update Target Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        2000,
        220
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "DmISg5P6tbWAXQv6",
          "name": "Google Sheets account"
        }
      },
      "continueOnFail": true
    }
  ],
