    {
      "parameters": {
        "jsCode": "const warmOpens = $items('Read Warm Opens').map(i => i.json);\nconst calls = $items('Read Call Tracker').map(i => i.json);\n\nconst hotLeads = warmOpens.filter(w => Number(w.open_count || 0) >= 3);\nconst bookedCalls = warmOpens.filter(w => (w.booking_url || '').length > 0);\n\nconst hotList = hotLeads.slice(0, 5).map(w => `• ${w.name || w.email} (${w.company || ''}) — ${w.open_count} opens`).join('\\n');\nconst bookedList = bookedCalls.slice(0, 5).map(w => `• ${w.name || w.email} — ${w.booking_url}`).join('\\n');\n\nconst textBlocks = [\n  `*Warm opens (3+)*: ${hotLeads.length}`,\n  hotList ? hotList : 'No hot leads yet.',\n  `\\n*Booked calls*: ${bookedCalls.length}`,\n  bookedList ? bookedList : 'No bookings yet.',\n  `\\n*Recent calls logged*: ${calls.length}`\n];\n\nreturn {\n  json: {\n    blocks: [\n      {\n        type: 'header',\n        text: {\n          type: 'plain_text',\n          text: '☀️ Morning Briefing',\n          emoji: true\n        }\n      },\n      {\n        type: 'section',\n        text: {\n          type: 'mrkdwn',\n          text: textBlocks.join('\\n')\n        }\n      }\n    ]\n  }\n};"
      },
