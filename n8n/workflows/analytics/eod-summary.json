    {
      "parameters": {
        "jsCode": "const calls = $items('Read Call Tracker').map(i => i.json);\nconst leads = $items('Read Qualified Leads').map(i => i.json);\n\nconst now = new Date();\nconst dayAgo = new Date(now - 24 * 60 * 60 * 1000);\n\nconst callsToday = calls.filter(c => c.called_at && new Date(c.called_at) >= dayAgo);\nconst booked = callsToday.filter(c => String(c.meeting_booked).toLowerCase() === 'true');\n\nconst leadsToday = leads.filter(l => l.scored_at && new Date(l.scored_at) >= dayAgo);\n\nconst callList = callsToday.slice(0, 5).map(c => `• ${c.name || c.email} — ${c.outcome || 'unknown'}`).join('\\n');\nconst leadList = leadsToday.slice(0, 5).map(l => `• ${l.first_name || ''} ${l.last_name || ''} (${l.company || ''})`).join('\\n');\n\nconst textBlocks = [\n  `*Calls completed*: ${callsToday.length} (Booked: ${booked.length})`,\n  callList ? callList : 'No calls logged today.',\n  `\\n*New qualified leads*: ${leadsToday.length}`,\n  leadList ? leadList : 'No new leads today.'\n];\n\nreturn {\n  json: {\n    blocks: [\n      {\n        type: 'header',\n        text: {\n          type: 'plain_text',\n          text: '🌙 EOD Summary',\n          emoji: true\n        }\n      },\n      {\n        type: 'section',\n        text: {\n          type: 'mrkdwn',\n          text: textBlocks.join('\\n')\n        }\n      }\n    ]\n  }\n};"
      },
      "id": "build-summary",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
