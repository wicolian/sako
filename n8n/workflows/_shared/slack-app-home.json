    {
      "parameters": {
        "jsCode": "const leads = $items('Read Qualified Leads').map(i => i.json);\nconst content = $items('Read Content Backlog').map(i => i.json);\nconst calls = $items('Read Call Tracker').map(i => i.json);\nconst pr = $items('Read PR Backlog').map(i => i.json);\n\nconst now = new Date();\nconst dayAgo = new Date(now - 24 * 60 * 60 * 1000);\n\nconst leadsToday = leads.filter(l => l.scored_at && new Date(l.scored_at) >= dayAgo);\nconst pendingContent = content.filter(c => ['queued', 'draft', 'needs_review'].includes((c.status || '').toLowerCase()));\nconst callsToday = calls.filter(c => c.called_at && new Date(c.called_at) >= dayAgo);\nconst prQueued = pr.filter(p => (p.status || '').toLowerCase() === 'queued');\n\nconst view = {\n  type: 'home',\n  blocks: [\n    {\n      type: 'header',\n      text: {\n        type: 'plain_text',\n        text: 'Sako Command Center',\n        emoji: true\n      }\n    },\n    {\n      type: 'section',\n      text: {\n        type: 'mrkdwn',\n        text: `*Quick Stats*\\n• Qualified leads (24h): ${leadsToday.length}\\n• Pending content approvals: ${pendingContent.length}\\n• Calls logged (24h): ${callsToday.length}\\n• PR backlog queued: ${prQueued.length}`\n      }\n    },\n    {\n      type: 'section',\n      text: {\n        type: 'mrkdwn',\n        text: '*Quick Actions*\\n• `/sako leads today`\\n• `/sako brief <email>`\\n• `/sako content pending`\\n• `/sako metrics`'\n      }\n    }\n  ]\n};\n\nreturn {\n  json: {\n    userId: $json.userId,\n    view\n  }\n};"
      },
