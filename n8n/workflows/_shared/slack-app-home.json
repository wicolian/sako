    {
      "parameters": {
        "jsCode": "// Parse Slack Events payload (crypto disallowed in n8n 2.6+, rely on URL obscurity + payload validation)\nconst input = $input.first().json;\nconst body = input.body;\nconst payload = typeof body === 'string' ? JSON.parse(body) : body;\n\n// Handle url_verification challenge\nif (payload.type === 'url_verification') {\n  return { json: { isChallenge: true, challenge: payload.challenge } };\n}\n\n// Validate this looks like a Slack event\nif (!payload.team_id || !payload.event) {\n  throw new Error('Invalid Slack event payload');\n}\n\n// Check timestamp freshness (replay protection)\nconst timestamp = input.headers['x-slack-request-timestamp'];\nif (timestamp) {\n  const currentTime = Math.floor(Date.now() / 1000);\n  if (Math.abs(currentTime - parseInt(timestamp)) > 300) {\n    throw new Error('Slack request too old');\n  }\n}\n\nreturn {\n  json: {\n    isChallenge: false,\n    eventType: payload.event?.type,\n    userId: payload.event?.user,\n    teamId: payload.team_id\n  }\n};"
      },
      "id": "verify-slack",
      "name": "Verify Slack Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
