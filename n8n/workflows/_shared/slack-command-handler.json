{
  "id": "slack-command-handler",
  "name": "Slack Command Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-command",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "webhook",
      "name": "Slack Command Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "slack-command"
    },
    {
      "parameters": {
        "jsCode": "// Parse Slack slash command (crypto disallowed in n8n 2.6+, rely on URL obscurity + payload validation)\nconst input = $input.first().json;\nconst body = input.body;\n\n// Check timestamp freshness (replay protection)\nconst timestamp = input.headers['x-slack-request-timestamp'];\nif (timestamp) {\n  const currentTime = Math.floor(Date.now() / 1000);\n  if (Math.abs(currentTime - parseInt(timestamp)) > 300) {\n    throw new Error('Slack request too old');\n  }\n}\n\nlet payload = body;\nif (typeof body === 'string') {\n  payload = Object.fromEntries(new URLSearchParams(body));\n}\n\n// Validate this looks like a Slack command\nif (!payload.command || !payload.user_id) {\n  throw new Error('Invalid Slack command payload');\n}\n\nreturn {\n  json: {\n    text: (payload.text || '').trim(),\n    command: payload.command || '/sako',\n    userId: payload.user_id,\n    userName: payload.user_name,\n    channelId: payload.channel_id,\n    channelName: payload.channel_name,\n    responseUrl: payload.response_url\n  }\n};"
      },
      "id": "verify-slack",
      "name": "Verify Slack Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const text = ($input.first().json.text || '').trim();\nconst [command, ...rest] = text.split(/\\s+/).filter(Boolean);\nconst args = rest.join(' ');\n\nreturn {\n  json: {\n    command: command || 'help',\n    args,\n    rawText: text,\n    userId: $input.first().json.userId,\n    userName: $input.first().json.userName,\n    channelId: $input.first().json.channelId,\n    channelName: $input.first().json.channelName,\n    responseUrl: $input.first().json.responseUrl\n  }\n};"
      },
      "id": "parse-command",
      "name": "Parse Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.command }}",
        "rules": [
