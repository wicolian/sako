        "url": "={{ ($env.N8N_API_BASE_URL || $env.N8N_EDITOR_BASE_URL || $env.WEBHOOK_URL || 'http://localhost:5678').replace(/\\/$/, '') + '/api/v1/executions?limit=200' }}",
        "authentication": "none",
        "headerParameters": {
