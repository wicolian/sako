      "id": "fetch-executions",
      "name": "Fetch Executions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1120,
        260
      ],
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "const executions = $input.first().json.data || [];\nconst now = new Date();\nconst oneDayAgo = new Date(now - 24 * 60 * 60 * 1000);\n\nlet total = 0;\nlet success = 0;\nlet failed = 0;\n\nfor (const exec of executions) {\n  const startedAt = new Date(exec.startedAt);\n  if (startedAt < oneDayAgo) continue;\n  total++;\n  if (exec.finished && !exec.error) success++;\n  else failed++;\n}\n\nconst rate = total > 0 ? Math.round((success / total) * 100) : 0;\nconst text = `*n8n Health (last 24h)*\\n• Executions: ${total}\\n• Success: ${success}\\n• Failed: ${failed}\\n• Success Rate: ${rate}%\\n\\nFull report: #n8n-errors`;\n\nreturn {\n  json: {\n    response: {\n      response_type: 'ephemeral',\n      text\n    }\n  }\n};"
      },
