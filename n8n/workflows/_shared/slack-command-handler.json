      ]
    },
    {
      "parameters": {
        "jsCode": "const helpText = `*Sako Command Center*\n\n• /sako help — list commands\n• /sako leads [today|week|all]\n• /sako brief <email>\n• /sako qualify <email>\n• /sako content [pending|approved]\n• /sako metrics\n• /sako pr\n• /sako signals`;\n\nreturn {\n  json: {\n    response: {\n      response_type: 'ephemeral',\n      text: helpText\n    }\n  }\n};"
      },
