    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst range = ($json.args || 'today').toLowerCase();\nconst now = new Date();\nconst dayAgo = new Date(now - 24 * 60 * 60 * 1000);\nconst weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);\n\nconst isInRange = (date) => {\n  if (!date) return false;\n  const d = new Date(date);\n  if (range === 'week') return d >= weekAgo;\n  if (range === 'all') return true;\n  return d >= dayAgo;\n};\n\nconst filtered = items.filter(i => isInRange(i.scored_at));\nconst top = filtered.slice(0, 5).map(i => `• ${i.first_name || ''} ${i.last_name || ''} (${i.company || ''})`).join('\\n');\n\nconst text = `*Qualified Leads (${range})*\\nTotal: ${filtered.length}\\n${top ? `\\n${top}` : '\\nNo leads found.'}`;\n\nreturn {\n  json: {\n    response: {\n      response_type: 'ephemeral',\n      text\n    }\n  }\n};"
      },
