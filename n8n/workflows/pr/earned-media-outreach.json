        "jsCode": "const items = $json.apify_items || [];\nconst first = items[0] || {};\n\nconst status = String(first.validation_status || first.status || '').trim();\nconst analysis = String(first.validation_analysis || first.analysis || '').trim();\n\n// Conservative gating: only send if actor says it's OK\nconst deliverable = /okay to send/i.test(status);\n\nreturn {\n  json: {\n    email_to_verify: $('Extract Email').item.json.email_to_verify,\n    email_validation_status: status,\n    email_validation_analysis: analysis,\n    email_deliverable: deliverable\n  }\n};"
