      "parameters": {
        "model": "gpt-5.2",
        "messages": {
          "values": [
            {
              "content": "=Write a personalized outreach pitch for this media target:\n\n## PR Hook\n{{ $json.pr_hook }}\n\n## Target\n- Outlet: {{ $json.target_outlet }}\n- Format: {{ $json.target_format }}\n- Audience: {{ $json.audience_fit }}\n\n## Journalist Profile (if available)\n- Name: {{ $json.profile_name }}\n- Headline: {{ $json.profile_headline }}\n- Company: {{ $json.profile_company }}\n- Recent: {{ Array.isArray($json.profile_recent) ? $json.profile_recent.join('; ') : '' }}\n\n## Guidelines\n1. Keep it under 150 words\n2. Personalize to their audience\n3. Include 3 bullet talking points\n4. End with a clear CTA\n5. Don't be salesy - offer value\n\n## Output Format\nSubject: [subject line]\n\n[email body]"
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 500
        }
      },
      "id": "generate-pitch",
      "name": "Generate Personalized Pitch",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1120,
        200
      ],
      "credentials": {
        "openAiApi": {
          "id": "VJQjLnLDwAkI2PxY",
          "name": "OpenAi account"
        }
      }
