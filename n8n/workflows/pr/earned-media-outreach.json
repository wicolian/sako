    {
      "parameters": {
        "jsCode": "// Parse the generated pitch\nconst text = $input.first().json.text;\nconst target = $('Match Relevant Targets').item.json;\n\n// Extract subject and body\nconst subjectMatch = text.match(/Subject:\\s*(.+?)\\n/i);\nconst subject = subjectMatch?.[1]?.trim() || `Re: ${target.pr_hook?.substring(0, 50)}`;\nconst body = text.replace(/Subject:.+?\\n/i, '').trim();\n\nreturn {\n  json: {\n    ...target,\n    email_subject: subject,\n    email_body: body,\n    generated_at: new Date().toISOString()\n  }\n};"
      },
      "id": "format-email",
      "name": "Format Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const current = $input.first().json;\nconst raw = String(current.target_contact || '').trim();\n\n// Extract first email-like token from the contact field\nconst match = raw.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i);\nconst email = match?.[0]?.toLowerCase() || '';\n\nreturn {\n  json: {\n    email_to_verify: email\n  }\n};"
      },
