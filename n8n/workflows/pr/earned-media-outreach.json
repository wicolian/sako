    {
      "parameters": {
        "jsCode": "// Match PR hooks with relevant media targets\nconst prItems = $('Check for Published PR').all().map(i => i.json);\nconst targets = $input.all().map(i => i.json);\n\n// Get most recent published PR\nconst latestPR = prItems[0];\n\n// Filter targets by audience fit\nconst relevantTargets = targets.filter(t => {\n  const audienceFit = (t.audience_fit || '').toLowerCase();\n  const prPillar = (latestPR?.pillar || '').toLowerCase();\n  const prHook = (latestPR?.hook || '').toLowerCase();\n  \n  // Basic relevance matching\n  return audienceFit.includes('saas') || \n         audienceFit.includes('design') || \n         audienceFit.includes('startup') ||\n         audienceFit.includes(prPillar);\n}).slice(0, 10); // Limit to 10 outreach targets\n\nreturn relevantTargets.map(target => ({\n  json: {\n    pr_id: latestPR?.id,\n    pr_hook: latestPR?.hook,\n    pr_pillar: latestPR?.pillar,\n    target_outlet: target.outlet_name,\n    target_contact: target.contact,\n    target_format: target.format,\n    audience_fit: target.audience_fit,\n    target_linkedin: target.linkedin_url || target.linkedin || ''\n  }\n}));"
      },
      "id": "match-targets",
      "name": "Match Relevant Targets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const target = $json;\nconst url = target.target_linkedin || '';\n\nreturn {\n  json: {\n    ...target,\n    has_linkedin: url.includes('linkedin.com')\n  }\n};"
      },
