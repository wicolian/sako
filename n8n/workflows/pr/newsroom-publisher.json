{
  "id": "newsroom-publisher",
  "name": "Newsroom Publisher",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "newsroom-publish",
        "options": {}
      },
      "id": "webhook",
      "name": "Trigger: Publish",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "newsroom-publish"
    },
    {
      "parameters": {
        "jsCode": "// Prepare newsroom content\nconst input = $input.first().json;\n\nconst content = {\n  type: input.type || 'release', // release, coverage, interview\n  title: input.title,\n  slug: input.title?.toLowerCase().replace(/[^a-z0-9]+/g, '-').substring(0, 50),\n  body: input.body || input.content,\n  date: new Date().toISOString(),\n  source_url: input.url || null,\n  outlet: input.outlet || null,\n  tags: input.tags || []\n};\n\nreturn { json: content };"
      },
      "id": "prepare-content",
      "name": "Prepare Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-5.2",
        "messages": {
          "values": [
            {
              "content": "=Generate social snippets for this newsroom post:\n\n## Content\nTitle: {{ $json.title }}\nType: {{ $json.type }}\nBody: {{ $json.body?.substring(0, 500) }}\n\n## Generate\n1. LinkedIn post (150 words, professional tone)\n2. X/Twitter post (280 chars max, punchy)\n3. Meta description for SEO (155 chars max)\n\n## Output Format (JSON)\n{\n  \"linkedin\": \"...\",\n  \"twitter\": \"...\",\n  \"meta_description\": \"...\"\n}"
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 600
        }
      },
      "id": "generate-snippets",
      "name": "Generate Social Snippets",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        680,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "VJQjLnLDwAkI2PxY",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse snippets and prepare for publishing\nconst content = $('Prepare Content').item.json;\nconst snippetText = $input.first().json.text;\n\nlet snippets;\ntry {\n  const jsonMatch = snippetText.match(/\\{[\\s\\S]*\\}/);\n  snippets = jsonMatch ? JSON.parse(jsonMatch[0]) : {};\n} catch (e) {\n  snippets = {\n    linkedin: content.title,\n    twitter: content.title.substring(0, 250),\n    meta_description: content.title\n  };\n}\n\nreturn {\n  json: {\n    ...content,\n    snippets,\n    publish_url: `https://trysako.com/press/${content.type}s/${content.slug}`\n  }\n};"
      },
      "id": "format-publish",
      "name": "Format for Publish",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SAKO_MKT_API_URL }}/api/press/create",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"{{ $json.type }}\",\n  \"title\": \"{{ $json.title }}\",\n  \"slug\": \"{{ $json.slug }}\",\n  \"body\": \"{{ $json.body }}\",\n  \"date\": \"{{ $json.date }}\",\n  \"source_url\": \"{{ $json.source_url }}\",\n  \"outlet\": \"{{ $json.outlet }}\",\n  \"meta_description\": \"{{ $json.snippets.meta_description }}\"\n}",
        "options": {}
      },
      "id": "create-press-page",
      "name": "Create Press Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1120,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "sako-mkt-api",
          "name": "Sako Marketing API"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "https://api.indexnow.org/indexnow",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"host\": \"trysako.com\",\n  \"key\": \"{{ $env.INDEXNOW_KEY }}\",\n  \"urlList\": [\n    \"{{ $('Format for Publish').item.json.publish_url }}\",\n    \"https://trysako.com/press\"\n  ]\n}",
        "options": {}
      },
      "id": "submit-indexnow",
      "name": "Submit to IndexNow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1340,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "append",
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": 1620036434,
          "cachedResultName": "content_backlog",
          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/YOUR_GOOGLE_SHEET_ID/edit#gid=1620036434"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "=social_{{ $('Format for Publish').item.json.slug }}",
