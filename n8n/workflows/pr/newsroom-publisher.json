        "url": "https://slack.com/api/chat.postMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"channel\": \"#pr-coverage\",\n  \"blocks\": [\n    {\n      \"type\": \"header\",\n      \"text\": {\n        \"type\": \"plain_text\",\n        \"text\": \"📢 Newsroom Updated\",\n        \"emoji\": true\n      }\n    },\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \"*{{ $('Format for Publish').item.json.title }}*\\n\\nPublished to: <{{ $('Format for Publish').item.json.publish_url }}|/press>\\nSocial posts queued for approval.\"\n      }\n    }\n  ]\n}",
        "options": {}
      },
