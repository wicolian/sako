    },
    {
      "parameters": {
        "jsCode": "// Compile context for PR hook generation\nconst shippedTasks = $('Fetch Shipped Tasks').item.json?.data || [];\nconst posthogData = $('Fetch PostHog Events').item.json || {};\nconst objections = $('Fetch CRM Objections').all().map(i => i.json) || [];\nconst trendData = $('Normalize Trends').item?.json?.trends || [];\nconst newsData = $('Normalize Google News').item?.json?.headlines || [];\nconst xTrends = $('Normalize X Trends').item?.json?.x_trends || [];\n\n// Summarize shipped work\nconst shippedSummary = shippedTasks.slice(0, 10).map(t => ({\n  title: t.title,\n  category: t.category,\n  client: t.workspace?.name || 'Client'\n}));\n\n// Extract top objections\nconst topObjections = objections.slice(0, 5).map(o => o.objection || o.text);\n\nreturn {\n  json: {\n    shipped: shippedSummary,\n    shippedCount: shippedTasks.length,\n    objections: topObjections,\n    trends: trendData,\n    x_trends: xTrends,\n    news: newsData,\n    posthogHighlights: [\n      `Pricing page views trending ${ posthogData.results ? 'up' : 'stable' }`,\n      `${shippedTasks.length} tasks completed this week`\n    ]\n  }\n};"
      },
      "id": "compile-context",
      "name": "Compile Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        400
      ]
    },
    {
      "parameters": {
        "model": "gpt-5.2",
        "messages": {
          "values": [
            {
              "content": "=You are a PR strategist for Sako, a design subscription service for SaaS companies.\n\nBased on this week's data, generate 10 PR hook ideas:\n\n## Recent Shipped Work\n{{ $json.shipped.map(s => `- ${s.title} (${s.category}) for ${s.client}`).join('\\n') }}\n\n## Common Sales Objections (from calls)\n{{ $json.objections.map(o => `- ${o}`).join('\\n') }}\n\n## Behavior Signals\n{{ $json.posthogHighlights.join('\\n') }}\n\n## Trends (Google Trends)\n{{ ($json.trends || []).map(t => `- ${t}`).join('\\n') }}\n\n## Trends (X/Twitter)\n{{ ($json.x_trends || []).map(t => `- ${t}`).join('\\n') }}\n\n## Industry News (Google News)\n{{ ($json.news || []).map(n => `- ${n}`).join('\\n') }}\n\n## PR Pillars\n1. **Shipping receipts** - \"Sako shipped X in 48h\" stories\n2. **Data drops** - Industry insights, benchmarks, analysis\n3. **Founder POV** - Hot takes, contrarian views on design/SaaS\n\n## Output Format\nFor each hook, provide:\n- **Hook**: One compelling sentence\n- **Pillar**: shipping/data/founder_pov\n- **Proof needed**: What evidence supports this\n- **Risk level**: low/medium/high (high = needs careful fact-checking)\n\nGenerate 10 hooks, scored by newsworthiness (most newsworthy first)."
            }
          ]
        },
        "options": {
          "temperature": 0.8,
          "maxTokens": 2000
        }
      },
      "id": "generate-hooks",
      "name": "Generate 10 PR Hooks",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        900,
        400
      ],
      "credentials": {
        "openAiApi": {
          "id": "VJQjLnLDwAkI2PxY",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse generated hooks into structured format\nconst text = $input.first().json.text;\n\n// Extract hooks (basic parsing)\nconst hookMatches = text.split(/\\d+\\.\\s*\\*\\*Hook\\*\\*:/i).filter(h => h.trim());\n\nconst hooks = hookMatches.map((hookText, i) => {\n  const pillarMatch = hookText.match(/\\*\\*Pillar\\*\\*:\\s*(\\w+)/i);\n  const proofMatch = hookText.match(/\\*\\*Proof needed\\*\\*:\\s*([^\\*]+)/i);\n  const riskMatch = hookText.match(/\\*\\*Risk level\\*\\*:\\s*(\\w+)/i);\n  \n  const hookLine = hookText.split('\\n')[0].trim();\n  \n  return {\n    id: `pr_${Date.now()}_${i}`,\n    hook: hookLine.substring(0, 200),\n    pillar: pillarMatch?.[1]?.toLowerCase() || 'shipping',\n    proof_links: '[]',\n    status: 'queued',\n    risk_level: riskMatch?.[1]?.toLowerCase() || 'low'\n  };\n}).filter(h => h.hook.length > 10);\n\nreturn hooks.map(h => ({ json: h }));"
      },
