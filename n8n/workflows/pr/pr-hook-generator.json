        "jsCode": "const items = $json.apify_items || [];\nconst headlines = items\n  .map(i => i.title || i.headline || i.name)\n  .filter(Boolean)\n  .slice(0, 8);\n\nreturn {\n  json: {\n    headlines\n  }\n};"
