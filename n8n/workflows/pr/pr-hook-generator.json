    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const items = $json.apify_items || [];\nconst trends = items\n  .map(i => i.trend || i.name || i.topic || i.title || i.hashtag)\n  .filter(Boolean)\n  .slice(0, 10);\n\nreturn {\n  json: {\n    x_trends: trends\n  }\n};"
      },
      "id": "normalize-x-trends",
      "name": "Normalize X Trends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        940
