# =============================================================================
# n8n Marketing Automations - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# For Railway: Set these in the Railway dashboard under Variables
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Neon Postgres — pooler endpoint recommended)
# Connection string format:
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# -----------------------------------------------------------------------------
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=neondb
DB_POSTGRESDB_USER=
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# -----------------------------------------------------------------------------
# EXECUTION MODE
# -----------------------------------------------------------------------------
# "regular" = single-process, no Redis required (default for Railway)
# "queue"   = multi-worker, requires Redis (use for local dev with docker-compose)
EXECUTIONS_MODE=regular

# Uncomment if using queue mode (local dev with docker-compose):
# EXECUTIONS_MODE=queue
# QUEUE_BULL_REDIS_HOST=redis
# QUEUE_BULL_REDIS_PORT=6379
# QUEUE_BULL_REDIS_PASSWORD=
# QUEUE_HEALTH_CHECK_ACTIVE=true

# -----------------------------------------------------------------------------
# PROTOCOL + PROXY (Railway-specific)
# -----------------------------------------------------------------------------
N8N_PROTOCOL=https
N8N_HOST=n8n.sako.agency
WEBHOOK_URL=https://n8n.sako.agency/
N8N_PROXY_HOPS=1
N8N_EDITOR_BASE_URL=https://n8n.sako.agency/
N8N_PUSH_BACKEND=sse
N8N_SECURE_COOKIE=true

# IMPORTANT: Use PORT (Railway routing), NOT N8N_PORT.
# N8N_PORT=5678 + N8N_PROTOCOL=https makes n8n compute expected origin as
# https://domain:5678 which doesn't match browser's https://domain (443).
PORT=5678

# -----------------------------------------------------------------------------
# ENCRYPTION
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a secure 32+ character key and NEVER change it after setup
# Use: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# N8N_BASIC_AUTH_* was REMOVED in n8n 1.0 — do NOT use it.
# n8n now uses built-in User Management:
#   1. On first launch, n8n shows an owner setup screen (name, email, password).
#   2. Complete it — this creates the owner account stored in Postgres.
#   3. All subsequent visits require that email + password to log in.
#   4. N8N_ENCRYPTION_KEY MUST be set and NEVER change, or the owner account
#      and all credentials become unreadable.
# See: https://docs.n8n.io/hosting/configuration/user-management-self-hosted/

# -----------------------------------------------------------------------------
# EXECUTION PRUNING (Prevent Postgres bloat)
# -----------------------------------------------------------------------------
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# -----------------------------------------------------------------------------
# TIMEZONE (both required - see n8n docs)
# -----------------------------------------------------------------------------
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# -----------------------------------------------------------------------------
# n8n BEST PRACTICES (Feb 2026)
# -----------------------------------------------------------------------------
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# N8N_RUNNERS_ENABLED is REMOVED — deprecated in n8n 2.6+, task runners
# are enabled by default. Do NOT set this variable.

# Disable telemetry + personalization survey
N8N_PERSONALIZATION_ENABLED=false
N8N_DIAGNOSTICS_ENABLED=false

# -----------------------------------------------------------------------------
# WORKFLOW SYNC (optional — for scripts/sync-workflows.mjs)
# Create API key: n8n → Settings → n8n API → Create API key
# -----------------------------------------------------------------------------
# N8N_BASE_URL=https://n8n.sako.agency
# N8N_API_KEY=

# =============================================================================
# CREDENTIALS - Core GTM Stack
# =============================================================================

# -----------------------------------------------------------------------------
# APOLLO (Lead Database + Enrichment)
# Get API key: https://app.apollo.io/#/settings/integrations/api
# -----------------------------------------------------------------------------
APOLLO_API_KEY=

# -----------------------------------------------------------------------------
# BREVO (Email Campaigns + Open Tracking)
# Get API key: https://app.brevo.com/settings/keys/api
# Docs: https://developers.brevo.com/docs/getting-started
# -----------------------------------------------------------------------------
BREVO_API_KEY=

# -----------------------------------------------------------------------------
# QUO / OPENPHONE (Dialer + Call Transcriptions)
# Get API key: https://app.quo.com/settings/api
# Docs: https://www.quo.com/docs/mdx/api-reference/introduction
# -----------------------------------------------------------------------------
QUO_API_KEY=

# -----------------------------------------------------------------------------
# OPENAI (AI for ICP Scoring, Call Briefs, Content)
# Get API key: https://platform.openai.com/api-keys
# Model: gpt-5.2 (per Latest-Models-Only rule)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# =============================================================================
# CREDENTIALS - Supporting Services
# =============================================================================

# Slack (required for approvals + commands)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Apify (Web scraping)
# APIFY_API_TOKEN=

# Cal.com (Meeting bookings)
CALCOM_API_KEY=
CALCOM_BOOKING_LINK=https://cal.com/your-handle/intro-call
# CALCOM_WEBHOOK_SECRET=

# Calendly (Alternative to Cal.com)
# CALENDLY_API_KEY=

# PostHog (Product analytics)
# POSTHOG_API_KEY=
# POSTHOG_PROJECT_ID=

# Google (GA4, Search Console, Sheets)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# sako-v1 API
# SAKO_API_URL=https://api.trysako.com
# SAKO_API_KEY=

# S3/R2 (for backups)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT= # For R2: https://<account_id>.r2.cloudflarestorage.com

# =============================================================================
# DEPRECATED - Replaced by Apollo/Brevo/Quo
# =============================================================================
# CLEARBIT_API_KEY= # Replaced by Apollo
# RESEND_API_KEY=   # Replaced by Brevo
